      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "ENV_FILE": "${workspaceFolder}/env/.env.staging",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "palatium-ai: production (env/.env.prod)",
      "type": "debugpy",
      "request": "launch",
      "module": "palatium_ai.main",
      "cwd": "${workspaceFolder}",
