      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "ENV_FILE": "${workspaceFolder}/env/.env.dev",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "palatium-ai: staging (env/.env.staging)",
      "type": "debugpy",
      "request": "launch",
      "module": "palatium_ai.main",
      "cwd": "${workspaceFolder}",
