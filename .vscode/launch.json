{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "palatium-ai: default (env/.env)",
      "type": "debugpy",
      "request": "launch",
      "module": "palatium_ai.main",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "ENV_FILE": "${workspaceFolder}/env/.env",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "palatium-ai: development (env/.env.dev)",
      "type": "debugpy",
      "request": "launch",
