# =============================================================================
# env/.env.cloud.example — OpenAI LLM + OpenAI embeddings
# =============================================================================
# copy env\.env.cloud.example env\.env
# Заполните: POSTGRES_PASSWORD, JWT_SECRET, OPENAI_API_KEY, OPENAI_EMBEDDING_API_KEY
# Рекоменд.: LLM_FALLBACK_PROVIDERS="anthropic" + ANTHROPIC_API_KEY
# Канон ключей = env/.env.example
# =============================================================================

# ---- App ----
APP_NAME="palatium-ai"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
APP_HOST="127.0.0.1"
APP_PORT=8000

# ---- Logging ----
LOG_LEVEL="INFO"
LOG_JSON=false
LOG_FILE=""
LOG_JSON_FILE=""
LOG_FILTER_MODULES=""
LOG_SUPPRESS_MODULES="urllib3,asyncio,httpx,httpcore,openai,LiteLLM,litellm"

# ---- Database ----
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="postgres"                        # не palatium_dev: схемы живут внутри этой БД
POSTGRES_SCHEMA="palatium_ai"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=15
DB_STARTUP_TIMEOUT_SECONDS=60
DB_ECHO=false
DB_RETRY_ATTEMPTS=4
DB_RETRY_INITIAL_DELAY_SECONDS=0.25
DB_RETRY_MAX_DELAY_SECONDS=2

# ---- Redis ----
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_SOCKET_KEEPALIVE=true

# ---- Security ----
AUTH_ENABLED=true
JWT_ALGORITHM="HS256"
JWT_SECRET="change-me-dev-only-min-32-chars!!"
HITL_SIGNING_SECRET=""
HITL_STEP_UP_METHOD="hmac_stub"
HITL_STEP_UP_REQUIRED_ACR="urn:palatium:acr:step-up"
HITL_STEP_UP_REQUIRED_AMR=""
HITL_STEP_UP_CARD_CLAIM="hitl_card_id"
HITL_STEP_UP_MAX_AGE_SECONDS="300"
HITL_STEP_UP_AUTHORIZE_URL="http://127.0.0.1:8000/api/auth/dev-hitl-step-up?card_id={card_id}&subject={subject}&challenge={challenge}&required_acr={required_acr}&card_claim={card_claim}&method={method}"
HITL_STEP_UP_REQUIRED=""
HITL_NOTIFY_WEBHOOK_URL=""
HITL_NOTIFY_WEBHOOK_TIMEOUT_SECONDS="5"
HITL_NOTIFY_EMAIL_TO=""
HITL_NOTIFY_EMAIL_FROM=""
HITL_NOTIFY_SMTP_HOST=""
HITL_NOTIFY_SMTP_PORT="587"
HITL_NOTIFY_SMTP_USERNAME=""
HITL_NOTIFY_SMTP_PASSWORD=""
HITL_NOTIFY_SMTP_USE_TLS="true"
HITL_NOTIFY_SLACK_BOT_TOKEN=""
HITL_NOTIFY_SLACK_CHANNEL=""
JWKS_URL=""
JWT_ISSUER=""
JWT_AUDIENCE=""
JWT_DEV_TOKEN_TTL_SECONDS=43200
CORS_ORIGINS="http://127.0.0.1:8000,http://localhost:8000"
METRICS_PUBLIC=true
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_PATH_PREFIXES="/api/intents/,/api/hitl/,/api/documents/,/api/sessions/,/api/admin/,/api/agents/,/api/memory/"
ADMIN_ROLES="admin"
MANAGER_ROLES="manager,admin"

# ---- LLM (OpenAI) ----
LLM_DEFAULT_PROVIDER="openai"
LLM_FALLBACK_PROVIDERS=""
LLM_TIER_NANO_PROVIDER="openai"
LLM_TIER_NANO_MODEL="gpt-4o-mini"
LLM_TIER_SMALL_PROVIDER="openai"
LLM_TIER_SMALL_MODEL="gpt-4o-mini"
LLM_TIER_MID_PROVIDER="openai"
LLM_TIER_MID_MODEL="gpt-4o"
LLM_TIER_FRONTIER_PROVIDER="openai"
LLM_TIER_FRONTIER_MODEL="gpt-4o"
LLM_TIER_DEEP_REASONING_PROVIDER="openai"
LLM_TIER_DEEP_REASONING_MODEL="o3-mini"

# --- LiteLLM Gateway (provider="gateway") ---
# Активный провайдер выше = openai, поэтому значения инертны; объявлены для
# паритета набора ключей с env/.env.example (см. §6 канона).
PALATIUM_GATEWAY_URL="http://litellm:4000"
PALATIUM_GATEWAY_KEY=""                       # [SECRET]
GATEWAY_DEFAULT_MODEL="tier-small"
GATEWAY_TIMEOUT=120

OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-5"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=3

OLLAMA_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="llama3.2"
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.1

QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
QWEN_DEFAULT_MODEL="qwen-turbo"
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=3
QWEN_TEMPERATURE=0.1
QWEN_MAX_TOKENS=4096

# ---- Embeddings (OpenAI) ----
EMBEDDING_DEFAULT_PROVIDER="openai"
# Схемы жёстко привязаны к размерности (060): memory=4096, knowledge=1536.
MEMORY_EMBEDDING_PROVIDER="qwen"
KNOWLEDGE_EMBEDDING_PROVIDER=""

OPENAI_EMBEDDING_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
OPENAI_EMBEDDING_TIMEOUT=60

OLLAMA_EMBEDDING_API_KEY=""
OLLAMA_EMBEDDING_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_EMBEDDING_DIMENSION=768
OLLAMA_EMBEDDING_TIMEOUT=120

QWEN_EMBEDDING_API_KEY=""
QWEN_EMBEDDING_MODEL="text-embedding-v3"
QWEN_EMBEDDING_DIMENSION=1024
QWEN_EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
QWEN_EMBEDDING_TIMEOUT=60

COHERE_EMBEDDING_API_KEY=""
COHERE_EMBEDDING_MODEL="embed-multilingual-v3.0"
COHERE_EMBEDDING_DIMENSION=1024
COHERE_EMBEDDING_BASE_URL="https://api.cohere.com/v1"
COHERE_EMBEDDING_TIMEOUT=60

# ---- Memory / web fallback ----
MEMORY_BACKEND=postgres
MEMORY_RECALL_MIN_CONFIDENCE=0.7
MEMORY_RECALL_MAX_ITEMS=4
MEMORY_RECALL_MAX_CHARS=800
CONTEXTUALIZER_DIALOG_MAX_CHARS=12000
WORKER_SUMMARY_MAX_CHARS=8000
MCP_TOOL_OUTPUT_MAX_CHARS=3000
MEMORY_SESSION_TTL_SECONDS=1800
LANGGRAPH_CHECKPOINT_POSTGRES=true
MEMORY_EMBEDDING_RERANK=false
# Wave M8 (eval-gated; OFF by default)
MEMORY_IMPORTANCE_HALF_LIFE_DAYS=7
MEMORY_CROSS_ENCODER_RERANK=false
MEMORY_BINARY_QUANTIZE_RERANK=false
MEMORY_BAYESIAN_TRUST=false
MEMORY_XMEMORY_DECOUPLE=false
MEMORY_HEBBIAN_EDGE_BUMP=false
# Promote: medium → long-term граф (060; отдельная ось от extract, только batch)
MEMORY_PROMOTE_ENABLED=true
MEMORY_PROMOTE_MIN_ACCESS_FREQUENCY=3
MEMORY_PROMOTE_MIN_IMPORTANCE=0.7
MEMORY_PROMOTE_BATCH_LIMIT=32
MEM0_API_KEY=""
MEM0_HOST="https://api.mem0.ai"
MEM0_TIMEOUT_SECONDS=30
GRAPHITI_NEO4J_URI="bolt://localhost:7687"
GRAPHITI_NEO4J_USER="neo4j"
GRAPHITI_NEO4J_PASSWORD=""
GRAPH_QUERY_BACKEND="in_memory"

WEB_FALLBACK_BACKEND="stub"
WEB_FALLBACK_PROVIDER="ddg"
WEB_FALLBACK_API_KEY=""
WEB_FALLBACK_TIMEOUT_SECONDS=15
WEB_FALLBACK_RETRY_ATTEMPTS=3
WEB_FALLBACK_RETRY_DELAY_SECONDS=0.5
WEB_FALLBACK_CIRCUIT_FAILURES=3
WEB_FALLBACK_CIRCUIT_OPEN_SECONDS=30


# ---- MCP ----
MCP_ENABLED=true
MCP_AUTH_TOKEN="dev-mcp-local-token"
# JWT для MCP: HS256 aud=mcp:<server>; MCP_JWT_SECRET ≥32 chars.
# Предпочтительнее статического MCP_AUTH_TOKEN (MultiAuth: JWT, затем static).
MCP_JWT_SECRET="dev-mcp-jwt-secret-min-32-chars!!"  # [SECRET]
MCP_JWT_ISSUER="palatium-mcp"
MCP_JWT_ALGORITHM="HS256"
MCP_JWT_TTL_SECONDS=300
MCP_AUTH_REQUIRED=false
MCP_SERVER_AUTH_TOKENS={}
MCP_ALLOW_HTTP_LOOPBACK=true
MCP_HTTP_ALLOWED_HOSTS="localhost,127.0.0.1,::1,mcp-edms,mcp-analytics"
# Platform is Host-local — do not list platform URL here.
MCP_SERVERS='{"edms":"http://localhost:8080","analytics":"http://localhost:8081"}'
MCP_SERVERS_FILE=""
MCP_CONSUL_URL=""
MCP_CONSUL_PREFIX="mcp/"
MCP_CONSUL_TOKEN=""
MCP_CONSUL_DATACENTER=""
MCP_CONSUL_WATCH_INTERVAL=60
MCP_TIMEOUT_SECONDS=30
# Per-tool overrides (JSON object): {"edms.search_documents":15,"analytics.get_sales_metrics":20}
# Key precedence: "server.tool" → "tool" → "default"; miss → MCP_TIMEOUT_SECONDS.
# Invariant: every value must be < the calling AgentConfig.timeout_seconds (070).
MCP_TOOL_TIMEOUT_SECONDS={}
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_DELAY=1.0

# ---- MCP Retention (scripts) ----
MCP_RETENTION_ARCHIVE_DAYS=90
MCP_RETENTION_PURGE_YEARS=3
MCP_RETENTION_BATCH_SIZE=500
MCP_RETENTION_EVENT=""
MCP_RETENTION_SERVER_NAME=""
MCP_RETENTION_IS_ERROR=""
MCP_RETENTION_EXECUTE="false"

# ---- Global retention (ADR 0002; full matrix in env/.env.example §10b) ----
RETENTION_SESSION_DAYS=30
RETENTION_MEMORY_MEDIUM_DAYS=30
RETENTION_MEMORY_EPISODE_DAYS=365
RETENTION_MEMORY_PII_DAYS=90
RETENTION_ATTACHMENT_PII_DAYS=90
RETENTION_KNOWLEDGE_ORPHAN_DAYS=7
RETENTION_GRAPH_PII_DAYS=90
RETENTION_AUDIT_HOT_DAYS=90
RETENTION_CHECKPOINT_DAYS=30
RETENTION_LANGFUSE_DAYS=30
RETENTION_MCP_ARCHIVE_DAYS=90
RETENTION_MCP_PURGE_YEARS=3
RETENTION_BATCH_SIZE=200
RETENTION_ANONYMIZE_GRACE_DAYS=7
RETENTION_EXECUTE=false

# ---- Observability ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="palatium-ai-cloud"
TURN_HOP_BUDGET_MS=15000
MAX_QUALITY_REVISIONS=2
CIRCUIT_FAILURES_TO_OPEN=3
CIRCUIT_OPEN_SECONDS=30


# L1 exact-match response cache (P0.2)
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600
TURN_COST_BUDGET_USD=1.0
DAILY_COST_BUDGET_USD=25.0
OTEL_ENDPOINT=""
AUDIT_LOG_FILE="./logs/audit-chain.log"
AUDIT_HMAC_SECRET=""

# =============================================================================
# ---- Attachments (W2): blob storage, AV scan, intake limits ----
# =============================================================================
# Локально включено в безопасной конфигурации: filesystem (без MinIO-образа) +
# disabled (без clamd). В staging/production такая конфигурация отвергается на
# старте (fail-closed). «Как в проде»:
#   ATTACHMENTS_BLOB_BACKEND="minio"     + make attach-s3-up  (образ S3 НЕ анонимный!)
#   ATTACHMENTS_SCANNER_BACKEND="clamav" + make attach-up     (clamd 127.0.0.1:3310)
# Подробности и env-маппинг: docs/runbook.md §16.
ATTACHMENTS_ENABLED="true"
ATTACHMENTS_BLOB_BACKEND="filesystem"          # memory | filesystem | minio
ATTACHMENTS_FILESYSTEM_ROOT=".local/attachments"  # gitignored
ATTACHMENTS_MINIO_ENDPOINT="localhost:9000"
# Адрес, который видит БРАУЗЕР для presigned PUT (схема задаёт http/https).
# SigV4 подписывает Host — переписать URL после подписи нельзя.
# Именно 127.0.0.1, а не localhost: порт опубликован только на IPv4-loopback (020),
# а Windows резолвит localhost в ::1 первым и теряет ~2 с на каждый PUT.
ATTACHMENTS_MINIO_PUBLIC_ENDPOINT="http://127.0.0.1:9000"
ATTACHMENTS_MINIO_ACCESS_KEY=""                # [SECRET] = MINIO_ROOT_USER (нужно для minio)
ATTACHMENTS_MINIO_SECRET_KEY=""                # [SECRET] = MINIO_ROOT_PASSWORD (>=8 chars)
ATTACHMENTS_MINIO_BUCKET="palatium-attachments"
ATTACHMENTS_MINIO_SECURE="false"               # вне local/test обязателен true
ATTACHMENTS_MINIO_REGION="us-east-1"
ATTACHMENTS_SCANNER_BACKEND="disabled"         # disabled (dev/test) | clamav
ATTACHMENTS_CLAMAV_HOST="localhost"
ATTACHMENTS_CLAMAV_PORT=3310
ATTACHMENTS_CLAMAV_TIMEOUT_SECONDS="30"
# Лимиты приёма: заявленный размер перепроверяется по сохранённому объекту.
ATTACHMENTS_MAX_SIZE_BYTES=52428800            # 50 MiB
ATTACHMENTS_MAX_CHUNK_BYTES=8388608            # 8 MiB upload chunk / multipart piece
ATTACHMENTS_MAX_PER_TURN=5
ATTACHMENTS_MAX_FILENAME_CHARS=200
ATTACHMENTS_PRESIGNED_TTL_SECONDS=900
ATTACHMENTS_ATTACH_TTL_SECONDS=604800          # 7d; дольше треда, а не хода
ATTACHMENTS_INDEX_RETENTION_DAYS=365
ATTACHMENTS_MAX_PARSED_CHARS=2000000
ATTACHMENTS_MAX_PARSED_PAGES=500
ATTACHMENTS_SWEEP_BATCH_SIZE=200

# ---- Attachments: image OCR (progressive: Tesseract → Vision) ----
# Cloud template keeps OCR off until a vision alias is confirmed on the gateway.
# ``auto`` / ``gateway`` / ``tesseract`` — same semantics as env/.env.example.
ATTACHMENTS_IMAGE_OCR_BACKEND="disabled"       # disabled | auto | gateway | tesseract
ATTACHMENTS_IMAGE_OCR_MODEL=""                 # [MUST-SET for gateway] e.g. tier-vision; optional for auto
ATTACHMENTS_IMAGE_OCR_MAX_BYTES=8388608        # 8 MiB cap on the bytes sent to the model
ATTACHMENTS_IMAGE_OCR_TIMEOUT_SECONDS="30"
ATTACHMENTS_TESSERACT_CMD=""                   # optional absolute path when not on PATH
ATTACHMENTS_OCR_MIN_CHARS=12
ATTACHMENTS_OCR_MIN_PRINTABLE_RATIO="0.55"
ATTACHMENTS_OCR_MIN_CONFIDENCE="55"
ATTACHMENTS_PDF_MIN_AVG_CHARS_PER_PAGE=200
ATTACHMENTS_PDF_VISION_MAX_PAGES=20
ATTACHMENTS_PDF_FIGURE_ENRICHMENT="true"
ATTACHMENTS_PDF_FIGURE_MAX_PAGES=8
ATTACHMENTS_ANALYSIS_BACKEND="disabled"        # disabled | local (HITL ADA)
ATTACHMENTS_PII_POLICY="tag"                   # tag | mask | reject

# Knowledge hybrid fusion: weighted (default) | rrf (Reciprocal Rank Fusion).
KNOWLEDGE_HYBRID_FUSION="weighted"
KNOWLEDGE_RRF_K=60
# Optional second-stage cosine rerank (needs knowledge embedding client).
KNOWLEDGE_EMBEDDING_RERANK="false"
KNOWLEDGE_EMBEDDING_RERANK_OVERFETCH=3

# ---- Docker Compose only ----
POSTGRES_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6379
API_PUBLISH_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH="neo4j/palatium-neo4j"
UVICORN_WORKERS=2
RUN_MIGRATIONS=1
WITH_GRAPHITI=0
WITH_ATTACHMENTS=1

# =============================================================================
# Infra services — Docker Compose only (не Settings), читает `docker compose --env-file`
# =============================================================================
# Тот же контракт, что env/.env.example §13/§14. Ключи ниже нужны compose, а не
# приложению: объявлены здесь, чтобы смена профиля не оставляла инфра-сервис на
# дефолте compose. Главный из них — LITELLM_DB_URL: gateway обязан смотреть в
# ОТДЕЛЬНУЮ БД, иначе его alembic-head конфликтует с нашим (docs/runbook.md §6).

# ---- LiteLLM Gateway ----
LITELLM_MASTER_KEY="sk-palatium-master"        # [SECRET] он же fallback для PALATIUM_GATEWAY_KEY
LITELLM_DB_URL="postgresql://postgres:CHANGE_ME@postgres:5432/litellm"  # отдельная БД, НЕ POSTGRES_DB
LITELLM_LOG="INFO"                             # INFO (default) | DEBUG
LITELLM_PUBLISH_PORT=4000
UI_USERNAME="admin"                            # логин LiteLLM UI
UI_PASSWORD="changeme"                         # [SECRET] пароль LiteLLM UI

# ---- Langfuse (profile: observability; опционально) ----
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="http://langfuse:3000"
LANGFUSE_DB_URL="postgresql://postgres:CHANGE_ME@postgres:5432/langfuse"  # отдельная БД
LANGFUSE_PUBLISH_PORT=3000
LANGFUSE_NEXTAUTH_SECRET="change-me-in-production-min-32-chars"   # [SECRET][MUST-SET] >=32 символов
LANGFUSE_SALT="change-me-in-production-min-32-chars"              # [SECRET][MUST-SET] >=32 символов
LANGFUSE_NEXTAUTH_URL="http://localhost:3000"

# ---- Langfuse v3 dependencies (profile: observability) ----
# Structural values (ClickHouse URL/user/db, S3 bucket, org/project labels) are literals
# in docker-compose.yml; only credentials belong here (020).
CLICKHOUSE_PASSWORD=""                       # [SECRET][MUST-SET] ClickHouse user `langfuse`
LANGFUSE_ENCRYPTION_KEY=""                   # [SECRET][MUST-SET] exactly 64 hex chars
LANGFUSE_INIT_USER_PASSWORD=""               # [SECRET][MUST-SET] UI admin seeded on first boot

# ---- Observability overlay (deploy/observability; с базовым стеком не стартует) ----
PROMETHEUS_PUBLISH_PORT=9090
PROMETHEUS_RETENTION="15d"                     # bounded on purpose; audit evidence lives in AUDIT_LOG_FILE
PROMETHEUS_METRICS_TOKEN=""                    # [SECRET] Bearer для GET /metrics
ALERTMANAGER_PUBLISH_PORT=9093
GRAFANA_PUBLISH_PORT=3000
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD=""                      # [SECRET][MUST-SET] overlay отказывается стартовать на пустом
GRAFANA_ROOT_URL="http://localhost:3000"
LOKI_PUBLISH_PORT=3100

# ---- MCP gateway proxy (profile: mcp-gateway; опционально) ----
# Значения совпадают с дефолтами compose — раскомментировать, если нужен прокси-профиль.
# MCP_GATEWAY_SERVER="edms"                    # edms | analytics
# MCP_UPSTREAM_URL="http://mcp-edms:8080"      # stub/adapter, куда проксирует proxy
# MCP_UPSTREAM_BEARER=""                       # [SECRET] Bearer к upstream stub/adapter
# MCP_UPSTREAM_HTTP_ALLOWED_HOSTS="localhost,127.0.0.1,::1,edms,analytics,mcp-edms,mcp-analytics"

# ---- Attachments: compose-only overrides (profiles: attachments / attachments-s3) ----
# *_DOCKER и MINIO_IMAGE совпадают с дефолтами compose; раскомментировать, только
# если api-контейнер должен ходить НЕ туда, куда по умолчанию.
# ATTACHMENTS_FILESYSTEM_ROOT_DOCKER="/app/var/attachments"
# ATTACHMENTS_CLAMAV_HOST_DOCKER="clamav"
# ATTACHMENTS_MINIO_ENDPOINT_DOCKER="minio:9000"
# Store image is pinned by tag+digest in docker-compose.yml (Silo) instead of here,
# so an env file cannot silently swap the runtime image out from under the pin (050).
ATTACHMENTS_MINIO_API_PORT=9000
ATTACHMENTS_MINIO_CONSOLE_PORT=9001
