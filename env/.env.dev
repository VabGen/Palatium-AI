# env/.env.dev
# ENV_FILE=env/.env.dev poetry run python -m palatium_ai.main
 
APP_NAME="palatium-ai"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

LOG_LEVEL="DEBUG"
LOG_JSON=false
LOG_FILE="./logs/debug.log"
LOG_JSON_FILE="./logs/debug.json.log"
LOG_FILTER_MODULES=""
LOG_SUPPRESS_MODULES="urllib3,asyncio,httpx"


