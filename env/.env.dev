PALATIUM_GATEWAY_URL="http://litellm:4000"
PALATIUM_GATEWAY_KEY=""                       # [SECRET]
GATEWAY_DEFAULT_MODEL="tier-small"
GATEWAY_TIMEOUT=120

OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-5"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=3

OLLAMA_API_KEY="214f6d4c1715416486988d7275f64f8c.vQDlsS8mjBcJAX79OqehuVCl"
OLLAMA_BASE_URL="https://ollama.com/v1"
OLLAMA_DEFAULT_MODEL="gpt-oss:20b-cloud"
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.1

QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
QWEN_DEFAULT_MODEL="qwen-turbo"
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=3
QWEN_TEMPERATURE=0.1
QWEN_MAX_TOKENS=4096

# ---- Embeddings (Ollama local) ----
EMBEDDING_DEFAULT_PROVIDER="qwen"
# Схемы жёстко привязаны к размерности (060): memory=4096, knowledge=1536.
# Локальный ollama@768 к схемам не биндится — FTS / без векторов.
MEMORY_EMBEDDING_PROVIDER="qwen"
KNOWLEDGE_EMBEDDING_PROVIDER=""

OPENAI_EMBEDDING_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
OPENAI_EMBEDDING_TIMEOUT=60

OLLAMA_EMBEDDING_API_KEY=""
OLLAMA_EMBEDDING_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_EMBEDDING_DIMENSION=768
OLLAMA_EMBEDDING_TIMEOUT=120

QWEN_EMBEDDING_API_KEY="corporate-embedding"
QWEN_EMBEDDING_MODEL="embedding-model"
QWEN_EMBEDDING_DIMENSION=4096
QWEN_EMBEDDING_BASE_URL="http://model-embedding.shared.du.iba/v1"
QWEN_EMBEDDING_TIMEOUT=60

COHERE_EMBEDDING_API_KEY=""
COHERE_EMBEDDING_MODEL="embed-english-v3.0"
COHERE_EMBEDDING_DIMENSION=1024
COHERE_EMBEDDING_BASE_URL="https://api.cohere.com"
COHERE_EMBEDDING_TIMEOUT=60

# ---- Memory / web fallback ----
FORMATTER_DEBUG_STREAM_DELTAS=false

SKILLS_ROOTS=skills/procedural
SKILLS_CATALOG_MAX_CHARS=4000
SKILLS_REFERENCE_MAX_CHARS=12000

MEMORY_BACKEND=postgres
MEMORY_RECALL_MIN_CONFIDENCE=0.7
MEMORY_RECALL_MAX_ITEMS=4
MEMORY_RECALL_MAX_CHARS=800

MEMORY_HYBRID_FUSION=rrf
MEMORY_RRF_K=60
CONTEXTUALIZER_DIALOG_MAX_CHARS=6000
WORKER_SUMMARY_MAX_CHARS=4000
MCP_TOOL_OUTPUT_MAX_CHARS=3000
LANGGRAPH_CHECKPOINT_POSTGRES=true
MEMORY_EMBEDDING_RERANK=false
# Promote: medium → long-term граф (060; отдельная ось от extract, только batch)
MEMORY_PROMOTE_ENABLED=true
MEMORY_PROMOTE_MIN_ACCESS_FREQUENCY=3
MEMORY_PROMOTE_MIN_IMPORTANCE=0.7
MEMORY_PROMOTE_BATCH_LIMIT=32

MEMORY_PROMOTE_USER_IDS=
MEMORY_PROMOTE_INTERVAL_SECONDS=3600
MEM0_API_KEY=""
MEM0_HOST="https://api.mem0.ai"
MEM0_TIMEOUT_SECONDS=30
GRAPHITI_NEO4J_URI="bolt://localhost:7687"
GRAPHITI_NEO4J_USER="neo4j"
GRAPHITI_NEO4J_PASSWORD="palatium-neo4j"
GRAPH_QUERY_BACKEND="in_memory"

WEB_FALLBACK_BACKEND="stub"
WEB_FALLBACK_PROVIDER="ddg"
WEB_FALLBACK_API_KEY=""
WEB_FALLBACK_TIMEOUT_SECONDS=15
WEB_FALLBACK_RETRY_ATTEMPTS=3
WEB_FALLBACK_RETRY_DELAY_SECONDS=0.5
WEB_FALLBACK_CIRCUIT_FAILURES=3
WEB_FALLBACK_CIRCUIT_OPEN_SECONDS=30

# ---- MCP ----
MCP_ENABLED=true
MCP_AUTH_TOKEN="dev-mcp-local-token"
MCP_JWT_SECRET="dev-mcp-jwt-secret-min-32-chars!!"  # [SECRET] HS256 aud=mcp:<server>
MCP_JWT_ISSUER="palatium-mcp"
MCP_JWT_ALGORITHM="HS256"
MCP_JWT_TTL_SECONDS=300
MCP_AUTH_REQUIRED=false
MCP_SERVER_AUTH_TOKENS={}
MCP_ALLOW_HTTP_LOOPBACK=true
MCP_HTTP_ALLOWED_HOSTS="localhost,127.0.0.1,::1,mcp-edms,mcp-analytics"
# Platform is Host-local — do not list platform URL here.
MCP_SERVERS='{"edms":"http://localhost:8080","analytics":"http://localhost:8081"}'
MCP_SERVERS_FILE=""
MCP_CONSUL_URL=""
MCP_CONSUL_PREFIX="mcp/"
MCP_CONSUL_TOKEN=""
MCP_CONSUL_DATACENTER=""
MCP_CONSUL_WATCH_INTERVAL=60
MCP_TIMEOUT_SECONDS=30
# Per-tool overrides (JSON object): {"edms.search_documents":15,"analytics.get_sales_metrics":20}
# Key precedence: "server.tool" → "tool" → "default"; miss → MCP_TIMEOUT_SECONDS.
# Invariant: every value must be < the calling AgentConfig.timeout_seconds (070).
MCP_TOOL_TIMEOUT_SECONDS={}
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_DELAY=1.0

# ---- MCP Retention (scripts) ----
MCP_RETENTION_ARCHIVE_DAYS=90
MCP_RETENTION_PURGE_YEARS=3
MCP_RETENTION_BATCH_SIZE=500
MCP_RETENTION_EVENT=""
MCP_RETENTION_SERVER_NAME=""
MCP_RETENTION_IS_ERROR=""
MCP_RETENTION_EXECUTE="false"

# ---- Observability ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="palatium-ai-dev"
TURN_HOP_BUDGET_MS=15000
MAX_QUALITY_REVISIONS=2
CIRCUIT_FAILURES_TO_OPEN=3
CIRCUIT_OPEN_SECONDS=30
# L1 exact-match response cache (P0.2)
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600
# Adaptive Grounding: empty optional retrieval → LLM answer (fallback);
# required empty → clarification. Rollback = PCT=0.
ADAPTIVE_GROUNDING_ENABLED=true
ADAPTIVE_GROUNDING_ROLLOUT_PCT=100
GROUNDING_JUDGE_SAMPLE_RATE=0.01
GROUNDING_JUDGE_MODEL=tier-small
OTEL_CAPTURE_RAW_QUERY=false
TURN_COST_BUDGET_USD=0
DAILY_COST_BUDGET_USD=0
OTEL_ENDPOINT="http://localhost:4318"
AUDIT_LOG_FILE="./logs/audit-chain.log"
AUDIT_HMAC_SECRET=""

# =============================================================================
# ---- Attachments (W2): blob storage, AV scan, intake limits ----
# =============================================================================
# Локально включено в безопасной конфигурации: filesystem (без MinIO-образа) +
# disabled (без clamd). В staging/production такая конфигурация отвергается на
# старте (fail-closed). «Как в проде»:
#   ATTACHMENTS_BLOB_BACKEND="minio"     + make attach-s3-up  (образ S3 НЕ анонимный!)
#   ATTACHMENTS_SCANNER_BACKEND="clamav" + make attach-up     (clamd 127.0.0.1:3310)
# Подробности и env-маппинг: docs/runbook.md §16.
ATTACHMENTS_ENABLED="true"
ATTACHMENTS_BLOB_BACKEND="filesystem"          # memory | filesystem | minio
ATTACHMENTS_FILESYSTEM_ROOT=".local/attachments"  # gitignored
ATTACHMENTS_MINIO_ENDPOINT="localhost:9000"
# Адрес, который видит БРАУЗЕР для presigned PUT (схема задаёт http/https).
# SigV4 подписывает Host — переписать URL после подписи нельзя.
ATTACHMENTS_MINIO_PUBLIC_ENDPOINT="http://127.0.0.1:9000"
ATTACHMENTS_MINIO_ACCESS_KEY=""                # [SECRET] = MINIO_ROOT_USER (нужно для minio)
ATTACHMENTS_MINIO_SECRET_KEY=""                # [SECRET] = MINIO_ROOT_PASSWORD (>=8 chars)
ATTACHMENTS_MINIO_BUCKET="palatium-attachments"
ATTACHMENTS_MINIO_SECURE="false"               # вне local/test обязателен true
ATTACHMENTS_MINIO_REGION="us-east-1"
ATTACHMENTS_SCANNER_BACKEND="disabled"         # disabled (dev/test) | clamav
ATTACHMENTS_CLAMAV_HOST="localhost"
ATTACHMENTS_CLAMAV_PORT=3310
ATTACHMENTS_CLAMAV_TIMEOUT_SECONDS="30"
# Лимиты приёма: заявленный размер перепроверяется по сохранённому объекту.
ATTACHMENTS_MAX_SIZE_BYTES=52428800            # 50 MiB
ATTACHMENTS_MAX_CHUNK_BYTES=8388608            # 8 MiB upload chunk / multipart piece
ATTACHMENTS_MAX_PER_TURN=5
ATTACHMENTS_MAX_FILENAME_CHARS=200
ATTACHMENTS_PRESIGNED_TTL_SECONDS=900
ATTACHMENTS_ATTACH_TTL_SECONDS=604800          # 7d; дольше треда, а не хода
ATTACHMENTS_INDEX_RETENTION_DAYS=365
ATTACHMENTS_MAX_PARSED_CHARS=2000000
ATTACHMENTS_MAX_PARSED_PAGES=500
ATTACHMENTS_SWEEP_BATCH_SIZE=200

# ---- Attachments: image OCR (progressive: Tesseract → Vision) ----
# ``auto``: Tesseract first → quality gate → Vision escalate (tier-mid).
# Vision alias tier-mid verified 2026-09-28 (accepts image_url).
ATTACHMENTS_IMAGE_OCR_BACKEND="auto"           # disabled | auto | gateway | tesseract
ATTACHMENTS_IMAGE_OCR_MODEL="tier-mid"         # Vision escalate / gateway mode
ATTACHMENTS_IMAGE_OCR_MAX_BYTES=8388608        # 8 MiB cap on the bytes sent to the model
ATTACHMENTS_IMAGE_OCR_TIMEOUT_SECONDS="120"    # local override (example default 30)
ATTACHMENTS_TESSERACT_CMD=""                   # optional absolute path when not on PATH
ATTACHMENTS_OCR_MIN_CHARS=12
ATTACHMENTS_OCR_MIN_PRINTABLE_RATIO="0.55"
ATTACHMENTS_PDF_MIN_AVG_CHARS_PER_PAGE=200
ATTACHMENTS_PDF_VISION_MAX_PAGES=20
ATTACHMENTS_PDF_FIGURE_ENRICHMENT="true"
ATTACHMENTS_PDF_FIGURE_MAX_PAGES=8
ATTACHMENTS_ANALYSIS_BACKEND="local"           # disabled | local (HITL ADA)
ATTACHMENTS_PII_POLICY="tag"                   # tag | mask | reject

# Knowledge hybrid fusion: weighted (default) | rrf (Reciprocal Rank Fusion).
KNOWLEDGE_HYBRID_FUSION="weighted"
KNOWLEDGE_RRF_K=60
# Optional second-stage cosine rerank (needs knowledge embedding client).
KNOWLEDGE_EMBEDDING_RERANK="false"
KNOWLEDGE_EMBEDDING_RERANK_OVERFETCH=3

# ---- Docker Compose only ----
POSTGRES_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6379
API_PUBLISH_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH="neo4j/palatium-neo4j"
# X-Forward: reverse proxy перед Neo4j нет → false. За Traefik/nginx включать только
# вместе с пинами allow_proxies/allow_hosts: enabled=true без них = trust-all (020).
NEO4J_X_FORWARD_ENABLED=false
NEO4J_X_FORWARD_ALLOW_PROXIES=""
NEO4J_X_FORWARD_ALLOW_HOSTS=""
UVICORN_WORKERS=2
RUN_MIGRATIONS=1
WITH_GRAPHITI=0
WITH_ATTACHMENTS=1

# --- synced missing Settings keys ---
ALERTMANAGER_PUBLISH_PORT=9093
ATTACHMENTS_CLAMAV_HOST_DOCKER="clamav"
ATTACHMENTS_FILESYSTEM_ROOT_DOCKER="/app/var/attachments"
ATTACHMENTS_MINIO_API_PORT=9000
