LANGFUSE_PUBLIC_KEY=""
LANGFUSE_PUBLISH_PORT=3000                    # host-порт UI Langfuse (loopback)
LANGFUSE_SALT=""                              # [SECRET][MUST-SET] >=32 символов, уникальный на стенд
LANGFUSE_SECRET_KEY=""
LITELLM_DB_URL="postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/litellm"
LITELLM_LOG="INFO"                            # INFO (default) | DEBUG; уровень процессов gateway
LITELLM_MASTER_KEY="sk-palatium-master"
LITELLM_PUBLISH_PORT=4000                     # host-порт UI/API Gateway (loopback)
LOKI_PUBLISH_PORT=3100
MCP_GATEWAY_SERVER="edms"                   # edms | analytics
MCP_UPSTREAM_BEARER=""                      # [SECRET] Bearer toward upstream stub/adapter
MCP_UPSTREAM_HTTP_ALLOWED_HOSTS="localhost,127.0.0.1,::1,edms,analytics,mcp-edms,mcp-analytics"
MCP_UPSTREAM_URL="http://mcp-edms:8080"     # stub/adapter the proxy forwards to
MEMORY_BAYESIAN_TRUST=false                   # Beta-Bernoulli confidence on promote
MEMORY_BINARY_QUANTIZE_RERANK=false           # bit(4096) Hamming helpers; ANN column = separate migration
MEMORY_CROSS_ENCODER_RERANK=false             # CE wrap after hybrid (stub TokenOverlap in bootstrap)
MEMORY_HEBBIAN_EDGE_BUMP=false                # Hebbian weight bump on promote refresh
MEMORY_IMPORTANCE_HALF_LIFE_DAYS=7            # τ-decay half-life for search-time recency
MEMORY_SESSION_TTL_SECONDS=1800
MEMORY_XMEMORY_DECOUPLE=false                 # near-dup collapse before promote upsert
PALATIUM_EVAL_AGENT_PROVIDER=openai          # generator provider for independence check
PALATIUM_EVAL_JUDGE_MODEL=                    # optional override
PALATIUM_EVAL_JUDGE_PROVIDER=anthropic       # MUST differ from generator provider (040)
PALATIUM_EVAL_LIVE_JUDGE=0                   # 1 только для staging smoke / live nightly
PALATIUM_EVAL_LIVE_NIGHTLY=0                 # 1 = pytest full live nightly suite (expensive)
