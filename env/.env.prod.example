# =============================================================================
# env/.env.prod.example — каркас production (секреты ТОЛЬКО Vault/K8s)
# =============================================================================
# Файл — каркас без секретов. Inject process env перекрывает пустые значения.
# Обязательно: RS256+JWKS, HITL_SIGNING_SECRET, CORS, budgets>0, fallbacks,
# Redis password, Postgres password. См. docs/ops-readiness.md
# Канон ключей = env/.env.example
# =============================================================================

# ---- App ----
APP_NAME="palatium-ai"
APP_VERSION="0.1.0"
ENVIRONMENT="production"
APP_HOST="0.0.0.0"
APP_PORT=8000

# ---- Logging ----
LOG_LEVEL="INFO"
LOG_JSON=true
LOG_FILE="/var/log/palatium/prod.log"
LOG_JSON_FILE="/var/log/palatium/prod.json.log"
LOG_FILTER_MODULES=""
LOG_SUPPRESS_MODULES="urllib3,asyncio,httpx,httpcore,openai,LiteLLM,litellm"

# ---- Database ----
POSTGRES_HOST="postgres.prod.internal"
POSTGRES_PORT=5432
POSTGRES_USER="palatium_app"
POSTGRES_PASSWORD=""
POSTGRES_DB="palatium_prod"
POSTGRES_SCHEMA="palatium_ai"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# ---- Redis ----
REDIS_HOST="redis.prod.internal"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# ---- Security ----
AUTH_ENABLED=true
JWT_ALGORITHM="RS256"
JWT_SECRET=""
HITL_SIGNING_SECRET=""
HITL_STEP_UP_METHOD="idp_acr"
HITL_STEP_UP_REQUIRED_ACR="urn:palatium:acr:step-up"
HITL_STEP_UP_REQUIRED_AMR=""
HITL_STEP_UP_CARD_CLAIM="hitl_card_id"
HITL_STEP_UP_MAX_AGE_SECONDS="300"
HITL_STEP_UP_AUTHORIZE_URL=""
HITL_STEP_UP_REQUIRED="true"
HITL_NOTIFY_WEBHOOK_URL=""
HITL_NOTIFY_WEBHOOK_TIMEOUT_SECONDS="5"
HITL_NOTIFY_EMAIL_TO=""
HITL_NOTIFY_EMAIL_FROM=""
HITL_NOTIFY_SMTP_HOST=""
HITL_NOTIFY_SMTP_PORT="587"
HITL_NOTIFY_SMTP_USERNAME=""
HITL_NOTIFY_SMTP_PASSWORD=""
HITL_NOTIFY_SMTP_USE_TLS="true"
HITL_NOTIFY_SLACK_BOT_TOKEN=""
HITL_NOTIFY_SLACK_CHANNEL=""
JWKS_URL="https://idp.example.com/.well-known/jwks.json"
JWT_ISSUER="https://idp.example.com/"
JWT_AUDIENCE="palatium-ai"
JWT_DEV_TOKEN_TTL_SECONDS=3600
CORS_ORIGINS="https://app.example.com"
METRICS_PUBLIC=false
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_PATH_PREFIXES="/api/intents/,/api/hitl/,/api/documents/,/api/sessions/,/api/admin/,/api/agents/,/api/memory/"
ADMIN_ROLES="admin"
MANAGER_ROLES="manager,admin"

# ---- LLM ----
LLM_DEFAULT_PROVIDER="ollama"
LLM_FALLBACK_PROVIDERS="openai,anthropic"
LLM_TIER_NANO_PROVIDER="ollama"
LLM_TIER_NANO_MODEL="gpt-oss:20b-cloud"
LLM_TIER_SMALL_PROVIDER="ollama"
LLM_TIER_SMALL_MODEL="gpt-oss:20b-cloud"
LLM_TIER_MID_PROVIDER="ollama"
LLM_TIER_MID_MODEL="gpt-oss:20b-cloud"
LLM_TIER_FRONTIER_PROVIDER="ollama"
LLM_TIER_FRONTIER_MODEL="gpt-oss:120b-cloud"
LLM_TIER_DEEP_REASONING_PROVIDER="ollama"
LLM_TIER_DEEP_REASONING_MODEL="gpt-oss:120b-cloud"

OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-5"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=3

OLLAMA_API_KEY=""
OLLAMA_BASE_URL="https://ollama.com/v1"
OLLAMA_DEFAULT_MODEL="gpt-oss:120b-cloud"
OLLAMA_TIMEOUT=180
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.1

QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
QWEN_DEFAULT_MODEL="qwen-turbo"
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=3
QWEN_TEMPERATURE=0.1
QWEN_MAX_TOKENS=4096

# ---- Embeddings ----
EMBEDDING_DEFAULT_PROVIDER="qwen"

OPENAI_EMBEDDING_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
OPENAI_EMBEDDING_TIMEOUT=60

OLLAMA_EMBEDDING_API_KEY=""
OLLAMA_EMBEDDING_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_EMBEDDING_DIMENSION=768
OLLAMA_EMBEDDING_TIMEOUT=120

QWEN_EMBEDDING_API_KEY=""
QWEN_EMBEDDING_MODEL="embedding-model"
QWEN_EMBEDDING_DIMENSION=4096
QWEN_EMBEDDING_BASE_URL="http://model-embedding.shared.du.iba/v1"
QWEN_EMBEDDING_TIMEOUT=60

COHERE_EMBEDDING_API_KEY=""
COHERE_EMBEDDING_MODEL="embed-multilingual-v3.0"
COHERE_EMBEDDING_DIMENSION=1024
COHERE_EMBEDDING_BASE_URL="https://api.cohere.com/v1"
COHERE_EMBEDDING_TIMEOUT=60

# ---- Memory / web fallback ----
MEMORY_BACKEND=postgres
MEMORY_RECALL_MIN_CONFIDENCE=0.7
MEMORY_RECALL_MAX_ITEMS=4
MEMORY_RECALL_MAX_CHARS=800
CONTEXTUALIZER_DIALOG_MAX_CHARS=12000
WORKER_SUMMARY_MAX_CHARS=8000
MCP_TOOL_OUTPUT_MAX_CHARS=3000
LANGGRAPH_CHECKPOINT_POSTGRES=true
MEMORY_EMBEDDING_RERANK=true
MEM0_API_KEY=""
MEM0_HOST="https://api.mem0.ai"
MEM0_TIMEOUT_SECONDS=30
GRAPHITI_NEO4J_URI="bolt://neo4j.prod.internal:7687"
GRAPHITI_NEO4J_USER="neo4j"
GRAPHITI_NEO4J_PASSWORD=""
GRAPH_QUERY_BACKEND="in_memory"

WEB_FALLBACK_BACKEND="stub"
WEB_FALLBACK_PROVIDER="ddg"
WEB_FALLBACK_API_KEY=""
WEB_FALLBACK_TIMEOUT_SECONDS=15
WEB_FALLBACK_RETRY_ATTEMPTS=3
WEB_FALLBACK_RETRY_DELAY_SECONDS=0.5
WEB_FALLBACK_CIRCUIT_FAILURES=3
WEB_FALLBACK_CIRCUIT_OPEN_SECONDS=30

# ---- MCP ----
MCP_ENABLED=true
MCP_AUTH_TOKEN=""
MCP_AUTH_REQUIRED=true
MCP_SERVER_AUTH_TOKENS={}
MCP_ALLOW_HTTP_LOOPBACK=false
MCP_HTTP_ALLOWED_HOSTS=""
MCP_SERVERS='{"edms":"https://edms.internal/mcp","analytics":"https://analytics.internal/mcp","platform":"https://platform.internal/mcp"}'
MCP_SERVERS_FILE=""
MCP_CONSUL_URL=""
MCP_CONSUL_PREFIX="mcp/"
MCP_CONSUL_TOKEN=""
MCP_CONSUL_DATACENTER=""
MCP_CONSUL_WATCH_INTERVAL=60
MCP_TIMEOUT_SECONDS=30
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_DELAY=1.0

# ---- MCP Retention (scripts) ----
MCP_RETENTION_ARCHIVE_DAYS=90
MCP_RETENTION_PURGE_YEARS=3
MCP_RETENTION_BATCH_SIZE=500
MCP_RETENTION_EVENT=""
MCP_RETENTION_SERVER_NAME=""
MCP_RETENTION_IS_ERROR=""
MCP_RETENTION_EXECUTE="false"

# ---- Observability ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="palatium-ai-prod"
TURN_HOP_BUDGET_MS=15000
MAX_QUALITY_REVISIONS=2
CIRCUIT_FAILURES_TO_OPEN=3
CIRCUIT_OPEN_SECONDS=30
TURN_COST_BUDGET_USD=2.0
DAILY_COST_BUDGET_USD=200.0
OTEL_ENDPOINT="http://otel-collector:4317"
AUDIT_LOG_FILE="/var/log/palatium/audit-chain.log"
AUDIT_HMAC_SECRET=""

# ---- Docker Compose only (паритет ключей; prod обычно K8s) ----
POSTGRES_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6379
API_PUBLISH_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH=""
UVICORN_WORKERS=4
RUN_MIGRATIONS=1
WITH_GRAPHITI=0
