# =============================================================================
# env/.env.prod.example — каркас production (секреты ТОЛЬКО Vault/K8s)
# =============================================================================
# Файл — каркас без секретов. Inject process env перекрывает пустые значения.
# Обязательно: RS256+JWKS, HITL_SIGNING_SECRET, CORS, budgets>0, fallbacks,
# Redis password, Postgres password. См. docs/ops-readiness.md
# Канон ключей = env/.env.example
# =============================================================================

# ---- App ----
APP_NAME="palatium-ai"
APP_VERSION="0.1.0"
ENVIRONMENT="production"
APP_HOST="0.0.0.0"
APP_PORT=8000

# ---- Logging ----
LOG_LEVEL="INFO"
LOG_JSON=true
LOG_FILE="/var/log/palatium/prod.log"
LOG_JSON_FILE="/var/log/palatium/prod.json.log"
LOG_FILTER_MODULES=""
LOG_SUPPRESS_MODULES="urllib3,asyncio,httpx,httpcore,openai,LiteLLM,litellm"

# ---- Database ----
POSTGRES_HOST="postgres.prod.internal"
POSTGRES_PORT=5432
POSTGRES_USER="palatium_app"
POSTGRES_PASSWORD=""
POSTGRES_DB="palatium_prod"
POSTGRES_SCHEMA="palatium_ai"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=15
DB_STARTUP_TIMEOUT_SECONDS=60
DB_ECHO=false
DB_RETRY_ATTEMPTS=4
DB_RETRY_INITIAL_DELAY_SECONDS=0.25
DB_RETRY_MAX_DELAY_SECONDS=2

# ---- Redis ----
REDIS_HOST="redis.prod.internal"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_SOCKET_KEEPALIVE=true

# ---- Security ----
AUTH_ENABLED=true
JWT_ALGORITHM="RS256"
JWT_SECRET=""
HITL_SIGNING_SECRET=""
HITL_STEP_UP_METHOD="idp_acr"
HITL_STEP_UP_REQUIRED_ACR="urn:palatium:acr:step-up"
HITL_STEP_UP_REQUIRED_AMR=""
HITL_STEP_UP_CARD_CLAIM="hitl_card_id"
HITL_STEP_UP_MAX_AGE_SECONDS="300"
HITL_STEP_UP_AUTHORIZE_URL=""
HITL_STEP_UP_REQUIRED="true"
HITL_NOTIFY_WEBHOOK_URL=""
HITL_NOTIFY_WEBHOOK_TIMEOUT_SECONDS="5"
HITL_NOTIFY_EMAIL_TO=""
HITL_NOTIFY_EMAIL_FROM=""
HITL_NOTIFY_SMTP_HOST=""
HITL_NOTIFY_SMTP_PORT="587"
HITL_NOTIFY_SMTP_USERNAME=""
HITL_NOTIFY_SMTP_PASSWORD=""
HITL_NOTIFY_SMTP_USE_TLS="true"
HITL_NOTIFY_SLACK_BOT_TOKEN=""
HITL_NOTIFY_SLACK_CHANNEL=""
JWKS_URL="https://idp.example.com/.well-known/jwks.json"
JWT_ISSUER="https://idp.example.com/"
JWT_AUDIENCE="palatium-ai"
JWT_DEV_TOKEN_TTL_SECONDS=3600
CORS_ORIGINS="https://app.example.com"
METRICS_PUBLIC=false
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_PATH_PREFIXES="/api/intents/,/api/hitl/,/api/documents/,/api/sessions/,/api/admin/,/api/agents/,/api/memory/"
ADMIN_ROLES="admin"
MANAGER_ROLES="manager,admin"

# ---- LLM ----
LLM_DEFAULT_PROVIDER="ollama"
LLM_FALLBACK_PROVIDERS="openai,anthropic,qwen"
LLM_TIER_NANO_PROVIDER="ollama"
LLM_TIER_NANO_MODEL="gpt-oss:20b-cloud"
LLM_TIER_SMALL_PROVIDER="ollama"
LLM_TIER_SMALL_MODEL="gpt-oss:20b-cloud"
LLM_TIER_MID_PROVIDER="ollama"
LLM_TIER_MID_MODEL="gpt-oss:20b-cloud"
LLM_TIER_FRONTIER_PROVIDER="ollama"
LLM_TIER_FRONTIER_MODEL="gpt-oss:120b-cloud"
LLM_TIER_DEEP_REASONING_PROVIDER="ollama"
LLM_TIER_DEEP_REASONING_MODEL="gpt-oss:120b-cloud"

# --- LiteLLM Gateway (provider="gateway") ---
# Активный провайдер выше = ollama, поэтому эти значения инертны; объявлены для
# паритета набора ключей с env/.env.example (см. §6 канона).
PALATIUM_GATEWAY_URL="http://litellm:4000"
PALATIUM_GATEWAY_KEY=""                       # [SECRET]
GATEWAY_DEFAULT_MODEL="tier-small"
GATEWAY_TIMEOUT=120

OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-5"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=3

OLLAMA_API_KEY=""
OLLAMA_BASE_URL="https://ollama.com/v1"
OLLAMA_DEFAULT_MODEL="gpt-oss:120b-cloud"
OLLAMA_TIMEOUT=180
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.1

QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
QWEN_DEFAULT_MODEL="qwen-turbo"
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=3
QWEN_TEMPERATURE=0.1
QWEN_MAX_TOKENS=4096

# ---- Embeddings ----
EMBEDDING_DEFAULT_PROVIDER="qwen"
# Схемы жёстко привязаны к размерности (060): memory=4096, knowledge=1536.
MEMORY_EMBEDDING_PROVIDER="qwen"
KNOWLEDGE_EMBEDDING_PROVIDER=""

OPENAI_EMBEDDING_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
OPENAI_EMBEDDING_TIMEOUT=60

OLLAMA_EMBEDDING_API_KEY=""
OLLAMA_EMBEDDING_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_EMBEDDING_DIMENSION=768
OLLAMA_EMBEDDING_TIMEOUT=120

QWEN_EMBEDDING_API_KEY=""
QWEN_EMBEDDING_MODEL="embedding-model"
QWEN_EMBEDDING_DIMENSION=4096
QWEN_EMBEDDING_BASE_URL="http://model-embedding.shared.du.iba/v1"
QWEN_EMBEDDING_TIMEOUT=60

COHERE_EMBEDDING_API_KEY=""
COHERE_EMBEDDING_MODEL="embed-multilingual-v3.0"
COHERE_EMBEDDING_DIMENSION=1024
COHERE_EMBEDDING_BASE_URL="https://api.cohere.com/v1"
COHERE_EMBEDDING_TIMEOUT=60

# ---- Memory / web fallback ----
MEMORY_BACKEND=postgres
MEMORY_RECALL_MIN_CONFIDENCE=0.7
MEMORY_RECALL_MAX_ITEMS=4
MEMORY_RECALL_MAX_CHARS=800
CONTEXTUALIZER_DIALOG_MAX_CHARS=12000
WORKER_SUMMARY_MAX_CHARS=8000
MCP_TOOL_OUTPUT_MAX_CHARS=3000
LANGGRAPH_CHECKPOINT_POSTGRES=true
MEMORY_EMBEDDING_RERANK=true
# Promote: medium → long-term граф (060; отдельная ось от extract, только batch)
MEMORY_PROMOTE_ENABLED=true
MEMORY_PROMOTE_MIN_ACCESS_FREQUENCY=3
MEMORY_PROMOTE_MIN_IMPORTANCE=0.7
MEMORY_PROMOTE_BATCH_LIMIT=32
MEM0_API_KEY=""
MEM0_HOST="https://api.mem0.ai"
MEM0_TIMEOUT_SECONDS=30
GRAPHITI_NEO4J_URI="bolt://neo4j.prod.internal:7687"
GRAPHITI_NEO4J_USER="neo4j"
GRAPHITI_NEO4J_PASSWORD=""
GRAPH_QUERY_BACKEND="in_memory"

WEB_FALLBACK_BACKEND="stub"
WEB_FALLBACK_PROVIDER="ddg"
WEB_FALLBACK_API_KEY=""
WEB_FALLBACK_TIMEOUT_SECONDS=15
WEB_FALLBACK_RETRY_ATTEMPTS=3
WEB_FALLBACK_RETRY_DELAY_SECONDS=0.5
WEB_FALLBACK_CIRCUIT_FAILURES=3
WEB_FALLBACK_CIRCUIT_OPEN_SECONDS=30


# ---- MCP ----
MCP_ENABLED=true
MCP_AUTH_TOKEN=""
MCP_JWT_SECRET=""  # [SECRET] HS256 aud=mcp:<server> (≥32); required when MCP_AUTH_REQUIRED
MCP_JWT_ISSUER="palatium-mcp"
MCP_JWT_ALGORITHM="HS256"
MCP_JWT_TTL_SECONDS=300
MCP_AUTH_REQUIRED=true
MCP_SERVER_AUTH_TOKENS={}
MCP_ALLOW_HTTP_LOOPBACK=false
MCP_HTTP_ALLOWED_HOSTS=""
# Platform is Host-local — do not list platform URL here.
MCP_SERVERS='{"edms":"https://edms.internal/mcp","analytics":"https://analytics.internal/mcp"}'
MCP_SERVERS_FILE=""
MCP_CONSUL_URL=""
MCP_CONSUL_PREFIX="mcp/"
MCP_CONSUL_TOKEN=""
MCP_CONSUL_DATACENTER=""
MCP_CONSUL_WATCH_INTERVAL=60
MCP_TIMEOUT_SECONDS=30
# Per-tool overrides (JSON object): {"edms.search_documents":15,"analytics.get_sales_metrics":20}
# Key precedence: "server.tool" → "tool" → "default"; miss → MCP_TIMEOUT_SECONDS.
# Invariant: every value must be < the calling AgentConfig.timeout_seconds (070).
MCP_TOOL_TIMEOUT_SECONDS={}
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_DELAY=1.0

# ---- MCP Retention (scripts) ----
MCP_RETENTION_ARCHIVE_DAYS=90
MCP_RETENTION_PURGE_YEARS=3
MCP_RETENTION_BATCH_SIZE=500
MCP_RETENTION_EVENT=""
MCP_RETENTION_SERVER_NAME=""
MCP_RETENTION_IS_ERROR=""
MCP_RETENTION_EXECUTE="false"

# ---- Global retention (ADR 0002; full matrix in env/.env.example §10b) ----
RETENTION_SESSION_DAYS=30
RETENTION_MEMORY_MEDIUM_DAYS=30
RETENTION_MEMORY_EPISODE_DAYS=365
RETENTION_MEMORY_PII_DAYS=90
RETENTION_BATCH_SIZE=200
RETENTION_EXECUTE=false

# ---- Attachments (020: files are low-trust input) ----
# Production runs the real store and the real AV engine; the dev backends are
# refused at startup outside local/test, and attach mode never writes to knowledge.
# The client PUTs bytes straight to the presigned URL, so the address signed into it
# must be reachable *from the browser* — that is ATTACHMENTS_MINIO_PUBLIC_ENDPOINT,
# while ATTACHMENTS_MINIO_ENDPOINT is only how the API process reaches the store.
# SigV4 signs the Host header, so a URL signed for an internal name cannot be rewritten
# afterwards; when the two differ (cluster DNS vs public ingress) both MUST be set.
# Otherwise the client falls back to PUT /api/attachments/{id}/content.
ATTACHMENTS_ENABLED="true"
ATTACHMENTS_BLOB_BACKEND="minio"              # minio (memory|filesystem are dev-only)
ATTACHMENTS_FILESYSTEM_ROOT="/var/lib/palatium/attachments"  # inert while backend=minio; must be a writable volume
ATTACHMENTS_MINIO_ENDPOINT=""                 # [MUST-SET] host:port the API reaches
ATTACHMENTS_MINIO_PUBLIC_ENDPOINT=""          # [MUST-SET when it differs] browser-facing, e.g. https://s3.example
ATTACHMENTS_MINIO_ACCESS_KEY=""               # [SECRET][MUST-SET]
ATTACHMENTS_MINIO_SECRET_KEY=""               # [SECRET][MUST-SET]
ATTACHMENTS_MINIO_BUCKET="palatium-attachments"
ATTACHMENTS_MINIO_SECURE="true"               # startup error if false outside local/test
ATTACHMENTS_MINIO_REGION="us-east-1"
ATTACHMENTS_SCANNER_BACKEND="clamav"          # disabled is refused outside local/test
ATTACHMENTS_CLAMAV_HOST=""                    # [MUST-SET] clamd host (TCP, unauthenticated)
# docker-compose feeds the api container ATTACHMENTS_CLAMAV_HOST_DOCKER (default
# "clamav", the service name). An external clamd deployment MUST set it to the real
# host, otherwise the API fails closed (scan_failed) on every upload (020).
ATTACHMENTS_CLAMAV_PORT=3310
ATTACHMENTS_CLAMAV_TIMEOUT_SECONDS="30"
ATTACHMENTS_MAX_SIZE_BYTES=52428800           # 50 MiB
ATTACHMENTS_MAX_CHUNK_BYTES=8388608           # 8 MiB upload chunk / multipart piece
ATTACHMENTS_MAX_PER_TURN=5
ATTACHMENTS_MAX_FILENAME_CHARS=200
ATTACHMENTS_PRESIGNED_TTL_SECONDS=900
ATTACHMENTS_ATTACH_TTL_SECONDS=604800         # 7d; must outlive the thread, not the turn
ATTACHMENTS_INDEX_RETENTION_DAYS=365
ATTACHMENTS_MAX_PARSED_CHARS=2000000
ATTACHMENTS_MAX_PARSED_PAGES=500
ATTACHMENTS_SWEEP_BATCH_SIZE=200

# ---- Attachments: image OCR (progressive: Tesseract → Vision) ----
# ``disabled`` (prod default): intake refuses image/* (capability gating, 055).
# ``auto``: Tesseract first → quality gate → Vision escalate when model is set.
# ``gateway``: Vision primary (model alias MUST exist in deploy/litellm/config.yaml).
# ``tesseract``: local-only / air-gapped. Opt-in after a vision alias is wired.
ATTACHMENTS_IMAGE_OCR_BACKEND="disabled"       # disabled | auto | gateway | tesseract
ATTACHMENTS_IMAGE_OCR_MODEL=""                 # [MUST-SET for gateway] e.g. tier-vision; optional for auto
ATTACHMENTS_IMAGE_OCR_MAX_BYTES=8388608        # 8 MiB cap on the bytes sent to the model
ATTACHMENTS_IMAGE_OCR_TIMEOUT_SECONDS="30"
ATTACHMENTS_TESSERACT_CMD=""                   # optional absolute path when not on PATH
ATTACHMENTS_OCR_MIN_CHARS=12
ATTACHMENTS_OCR_MIN_PRINTABLE_RATIO="0.55"
ATTACHMENTS_OCR_MIN_CONFIDENCE="55"
ATTACHMENTS_PDF_MIN_AVG_CHARS_PER_PAGE=200
ATTACHMENTS_PDF_VISION_MAX_PAGES=20
ATTACHMENTS_PDF_FIGURE_ENRICHMENT="true"
ATTACHMENTS_PDF_FIGURE_MAX_PAGES=8
ATTACHMENTS_ANALYSIS_BACKEND="disabled"        # disabled | local (HITL ADA)
ATTACHMENTS_PII_POLICY="tag"                   # tag | mask | reject

# Knowledge hybrid fusion: weighted (default) | rrf (Reciprocal Rank Fusion).
KNOWLEDGE_HYBRID_FUSION="weighted"
KNOWLEDGE_RRF_K=60
# Optional second-stage cosine rerank (needs knowledge embedding client).
KNOWLEDGE_EMBEDDING_RERANK="false"
KNOWLEDGE_EMBEDDING_RERANK_OVERFETCH=3

# ---- Observability ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="palatium-ai-prod"
TURN_HOP_BUDGET_MS=15000
MAX_QUALITY_REVISIONS=2
CIRCUIT_FAILURES_TO_OPEN=3
CIRCUIT_OPEN_SECONDS=30


# L1 exact-match response cache (P0.2)
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600
TURN_COST_BUDGET_USD=2.0
DAILY_COST_BUDGET_USD=200.0
# OTLP/HTTP (в коде — HTTP-экспортёр: proto.http → порт 4318, путь /v1/traces).
# 4317 — это gRPC-порт; с HTTP-экспортёром даёт вечные "Failed to export span batch".
OTEL_ENDPOINT="http://otel-collector:4318"
AUDIT_LOG_FILE="/var/log/palatium/audit-chain.log"
AUDIT_HMAC_SECRET=""

# ---- Docker Compose only (паритет ключей; prod обычно K8s) ----
POSTGRES_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6379
API_PUBLISH_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH=""
UVICORN_WORKERS=4
RUN_MIGRATIONS=1
WITH_GRAPHITI=0
WITH_ATTACHMENTS=1

# =============================================================================
# Infra services — Docker Compose only (не Settings), читает `docker compose --env-file`
# =============================================================================
# Тот же контракт, что env/.env.example §13/§14. Ключи ниже нужны compose, а не
# приложению. LITELLM_DB_URL — обязателен и ДОЛЖЕН указывать на отдельную БД:
# alembic-head gateway не должен конфликтовать с нашим (docs/runbook.md §6).

# ---- LiteLLM Gateway ----
LITELLM_MASTER_KEY=""                          # [SECRET][MUST-SET] он же fallback для PALATIUM_GATEWAY_KEY
LITELLM_DB_URL=""                              # [SECRET][MUST-SET] postgresql://palatium_app:<pw>@<host>:5432/litellm — отдельная БД, НЕ POSTGRES_DB
LITELLM_LOG="INFO"                             # INFO (default) | DEBUG
LITELLM_PUBLISH_PORT=4000                      # в K8s не публикуется; для compose-смоука
UI_USERNAME="admin"                            # логин LiteLLM UI
UI_PASSWORD=""                                 # [SECRET][MUST-SET] пароль LiteLLM UI

# ---- Langfuse (profile: observability; опционально) ----
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="http://langfuse:3000"
LANGFUSE_DB_URL=""                             # [SECRET][MUST-SET] отдельная БД langfuse, НЕ POSTGRES_DB
LANGFUSE_PUBLISH_PORT=3000
LANGFUSE_NEXTAUTH_SECRET=""                    # [SECRET][MUST-SET] >=32 символов
LANGFUSE_SALT=""                               # [SECRET][MUST-SET] >=32 символов
LANGFUSE_NEXTAUTH_URL=""                       # [MUST-SET] внешний URL Langfuse (https://...)

# ---- Langfuse v3 dependencies (profile: observability) ----
# Структурные значения (ClickHouse URL/user/db, S3 bucket, org/project) — литералы в
# docker-compose.yml; сюда выносятся только секреты (020).
CLICKHOUSE_PASSWORD=""                         # [SECRET][MUST-SET] пароль пользователя ClickHouse `langfuse`
LANGFUSE_ENCRYPTION_KEY=""                     # [SECRET][MUST-SET] ровно 64 hex-символа; шифрует ключи провайдеров at-rest
LANGFUSE_INIT_USER_PASSWORD=""                 # [SECRET][MUST-SET] пароль UI-админа, создаётся на первом старте Langfuse

# ---- Observability overlay (deploy/observability; с базовым стеком не стартует) ----
PROMETHEUS_PUBLISH_PORT=9090
PROMETHEUS_RETENTION="15d"                     # bounded on purpose; audit evidence lives in AUDIT_LOG_FILE
PROMETHEUS_METRICS_TOKEN=""                    # [SECRET][MUST-SET] Bearer для GET /metrics
ALERTMANAGER_PUBLISH_PORT=9093
GRAFANA_PUBLISH_PORT=3000
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD=""                      # [SECRET][MUST-SET] overlay отказывается стартовать на пустом
GRAFANA_ROOT_URL=""                            # [MUST-SET] внешний URL Grafana
LOKI_PUBLISH_PORT=3100

# ---- MCP gateway proxy (profile: mcp-gateway; опционально) ----
MCP_GATEWAY_SERVER="edms"                      # edms | analytics
MCP_UPSTREAM_URL=""                            # [MUST-SET] stub/adapter, куда проксирует proxy
MCP_UPSTREAM_BEARER=""                         # [SECRET][MUST-SET] Bearer к upstream stub/adapter
MCP_UPSTREAM_HTTP_ALLOWED_HOSTS="localhost,127.0.0.1,::1,edms,analytics,mcp-edms,mcp-analytics"

# ---- Attachments: compose-only overrides (profiles: attachments / attachments-s3) ----
ATTACHMENTS_FILESYSTEM_ROOT_DOCKER="/app/var/attachments"
ATTACHMENTS_CLAMAV_HOST_DOCKER="clamav"
ATTACHMENTS_MINIO_ENDPOINT_DOCKER="minio:9000"
# Образ store закреплён по tag+digest в docker-compose.yml (Silo), а не здесь:
# иначе значение из env молча перебивало бы пин и подменяло runtime-образ (050).
ATTACHMENTS_MINIO_API_PORT=9000
ATTACHMENTS_MINIO_CONSOLE_PORT=9001
