FORMATTER_DEBUG_STREAM_DELTAS=false

# =============================================================================
# env/.env — локальный рабочий профиль (gitignored)
# =============================================================================
# Профиль: corporate Qwen через локальный LiteLLM Gateway.
# Структура секций = env/.env.example (канон). Секреты и overrides — здесь.
#
# Маппинг TIER_* → реальные провайдеры: docker-compose.yml → litellm.environment.
# =============================================================================


# =============================================================================
# 1) App
# =============================================================================
APP_NAME="palatium-ai"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
APP_HOST="127.0.0.1"
APP_PORT=8000


# =============================================================================
# 2) Logging
# =============================================================================
LOG_LEVEL="DEBUG"
LOG_JSON=false
LOG_FILE=""
LOG_JSON_FILE=""
LOG_FILTER_MODULES=""
LOG_SUPPRESS_MODULES="urllib3,asyncio,httpx,httpcore,openai,LiteLLM,litellm"


# =============================================================================
# 3) Database (PostgreSQL)
# =============================================================================
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="1234"
POSTGRES_DB="postgres"
POSTGRES_SCHEMA="palatium_ai"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=15
DB_STARTUP_TIMEOUT_SECONDS=60
DB_ECHO=false
DB_RETRY_ATTEMPTS=4
DB_RETRY_INITIAL_DELAY_SECONDS=0.25
DB_RETRY_MAX_DELAY_SECONDS=2


# =============================================================================
# 4) Cache (Redis)
# =============================================================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_SOCKET_KEEPALIVE=true


# =============================================================================
# 5) Security (Zero Trust)
# =============================================================================
AUTH_ENABLED=true
JWT_ALGORITHM="HS256"
JWT_SECRET="change-me-dev-only-min-32-chars!!"
HITL_SIGNING_SECRET=""
HITL_STEP_UP_METHOD="hmac_stub"
HITL_STEP_UP_REQUIRED_ACR="urn:palatium:acr:step-up"
HITL_STEP_UP_REQUIRED_AMR=""
HITL_STEP_UP_CARD_CLAIM="hitl_card_id"
HITL_STEP_UP_MAX_AGE_SECONDS="300"
HITL_STEP_UP_AUTHORIZE_URL="http://127.0.0.1:8000/api/auth/dev-hitl-step-up?card_id={card_id}&subject={subject}&challenge={challenge}&required_acr={required_acr}&card_claim={card_claim}&method={method}"
HITL_STEP_UP_REQUIRED=""
HITL_NOTIFY_WEBHOOK_URL=""
HITL_NOTIFY_WEBHOOK_TIMEOUT_SECONDS="5"
HITL_NOTIFY_EMAIL_TO=""
HITL_NOTIFY_EMAIL_FROM=""
HITL_NOTIFY_SMTP_HOST=""
HITL_NOTIFY_SMTP_PORT="587"
HITL_NOTIFY_SMTP_USERNAME=""
HITL_NOTIFY_SMTP_PASSWORD=""
HITL_NOTIFY_SMTP_USE_TLS="true"
HITL_NOTIFY_SLACK_BOT_TOKEN=""
HITL_NOTIFY_SLACK_CHANNEL=""
JWKS_URL=""
JWT_ISSUER=""
JWT_AUDIENCE=""
JWT_DEV_TOKEN_TTL_SECONDS=43200
# Vite SPA (5173/5174) + API origin for direct browser calls
CORS_ORIGINS="http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174"
METRICS_PUBLIC=true
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_PATH_PREFIXES="/api/intents/,/api/hitl/,/api/documents/,/api/sessions/,/api/admin/,/api/agents/,/api/memory/"
ADMIN_ROLES="admin"
MANAGER_ROLES="manager,admin"


# =============================================================================
# 6) AI / LLM
# =============================================================================
# Gateway: приложение → LiteLLM (:4000); алиасы tier-* понимает только шлюз.
LLM_DEFAULT_PROVIDER="gateway"
LLM_FALLBACK_PROVIDERS=""

LLM_TIER_NANO_PROVIDER="gateway"
LLM_TIER_NANO_MODEL="tier-nano"
LLM_TIER_SMALL_PROVIDER="gateway"
LLM_TIER_SMALL_MODEL="tier-small"
LLM_TIER_MID_PROVIDER="gateway"
LLM_TIER_MID_MODEL="tier-mid"
LLM_TIER_FRONTIER_PROVIDER="gateway"
LLM_TIER_FRONTIER_MODEL="tier-frontier"
LLM_TIER_DEEP_REASONING_PROVIDER="gateway"
LLM_TIER_DEEP_REASONING_MODEL="tier-deep"

# --- OpenAI ---
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# --- Anthropic ---
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-5"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=3

# --- Ollama Cloud (опционально) ---
OLLAMA_API_KEY="214f6d4c1715416486988d7275f64f8c.vQDlsS8mjBcJAX79OqehuVCl"
OLLAMA_BASE_URL="https://ollama.com/v1"
OLLAMA_DEFAULT_MODEL="gpt-oss:20b-cloud"
OLLAMA_TIMEOUT=60
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.1

# --- Corporate Qwen (OpenAI-compatible) ---
QWEN_API_KEY="corporate-llm"
QWEN_BASE_URL="http://model-generative.shared.du.iba/v1"
QWEN_DEFAULT_MODEL="generative-model"
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=3
QWEN_TEMPERATURE=0.1
QWEN_MAX_TOKENS=4096

# --- LiteLLM Gateway (provider=gateway) ---
# Poetry-host: 127.0.0.1. Compose api-контейнер переопределяет на http://litellm:4000.
PALATIUM_GATEWAY_URL="http://127.0.0.1:4000"
PALATIUM_GATEWAY_KEY="sk-3b472smAsxsCSltfv1xgAA"
GATEWAY_DEFAULT_MODEL="tier-small"
GATEWAY_TIMEOUT=120


# =============================================================================
# 7) Embeddings
# =============================================================================
EMBEDDING_DEFAULT_PROVIDER="qwen"
MEMORY_EMBEDDING_PROVIDER="qwen"
KNOWLEDGE_EMBEDDING_PROVIDER=""

OPENAI_EMBEDDING_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
OPENAI_EMBEDDING_TIMEOUT=60

OLLAMA_EMBEDDING_API_KEY=""
