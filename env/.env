# env/.env

# =====================================================================
# palatium-ai – локальный файл окружения для разработки
# =====================================================================

# ---- App ----
APP_NAME="palatium-ai"
APP_VERSION="0.1.0"
ENVIRONMENT="development"

# ---- Logging ----
LOG_LEVEL="DEBUG"
LOG_JSON=false
LOG_FILE=""
LOG_JSON_FILE=""
LOG_FILTER_MODULES=""
LOG_SUPPRESS_MODULES="urllib3,asyncio,httpx"

# ---- Database (PostgreSQL) ----
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="1234"
POSTGRES_DB="palatium_dev"
POSTGRES_SCHEMA="palatium_ai"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=true

# ---- Cache (Redis) ----
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# ---- Security (Zero Trust) ----
JWT_ALGORITHM="RS256"
JWKS_URL="https://your-auth-provider.com/.well-known/jwks.json"
API_RATE_LIMIT=100

# ---- AI / LLM ----
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
LLM_DEFAULT_MODEL="gpt-4o"
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ---- MCP ----
MCP_ENABLED=true
MCP_ENDPOINTS='["http://localhost:8001/sse"]'
MCP_TIMEOUT_SECONDS=30

# ---- Observability ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="lsv2_..."
LANGCHAIN_PROJECT="palatium-ai-dev"
OTEL_ENDPOINT="http://localhost:4317"