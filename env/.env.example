# env/.env.example

# =====================================================================
# palatium-ai – шаблон файла окружения
# Скопируйте в .env.* и заполните своими значениями
# =====================================================================

# ---- App ----
APP_NAME="palatium-ai"
APP_VERSION="0.1.0"
ENVIRONMENT="development"                     # development | staging | production

# ---- Logging ----
LOG_LEVEL="DEBUG"                             # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                                # true/false – вывод в JSON
LOG_FILE=""                                   # путь к текстовому лог-файлу
LOG_JSON_FILE=""                              # путь к JSON-лог-файлу
LOG_FILTER_MODULES=""                         # модули для полной фильтрации (через запятую)
LOG_SUPPRESS_MODULES="urllib3,asyncio,httpx"  # модули для подавления до WARNING

# ---- Database (PostgreSQL) ----
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_password"
POSTGRES_DB="palatium_dev"
POSTGRES_SCHEMA="public"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- Cache (Redis) ----
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# ---- Security (Zero Trust) ----
JWT_ALGORITHM="RS256"
JWKS_URL="https://your-auth-provider.com/.well-known/jwks.json"
API_RATE_LIMIT=100

# ---- AI / LLM ----
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
OLLAMA_BASE_URL="http://localhost:11434"
LLM_DEFAULT_MODEL="gpt-4o"
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ---- MCP (Model Context Protocol) ----
MCP_ENABLED=true
MCP_ENDPOINTS='["http://localhost:8001/sse", "http://localhost:8002/sse"]'
MCP_TIMEOUT_SECONDS=30

# ---- Observability (LangSmith / OpenTelemetry) ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="lsv2_..."
LANGCHAIN_PROJECT="palatium-ai-dev"
OTEL_ENDPOINT="http://localhost:4317"