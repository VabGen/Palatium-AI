# =============================================================================
# env/.env.example — канонический шаблон palatium-ai (2026)
# =============================================================================
#
# НАЗНАЧЕНИЕ
#   Единственный полный справочник переменных. Рабочие файлы (секреты) НЕ в git:
#     env/.env · env/.env.dev · env/.env.staging · env/.env.prod
#
# БЫСТРЫЙ СТАРТ (админ / первый подъём)
#   1) copy env\.env.example env\.env
#   2) Заполните блок «МИНИМУМ ДЛЯ ЛОКАЛЬНОГО СТАРТА» ниже (поиск: MUST-SET).
#   3) Выберите LLM-профиль ИЛИ скопируйте готовый:
#        env/.env.local.example  → полностью локальный Ollama
#        env/.env.cloud.example  → OpenAI cloud
#        env/.env.staging.example / env/.env.prod.example → каркасы деплоя
#   4) Поднимите зависимости: Postgres + Redis (+ MCP stubs: .\scripts\dev-up.ps1)
#   5) Миграции: poetry run alembic upgrade head
#   6) Запуск:
#        $env:ENV_FILE="env/.env"
#        poetry run python -m palatium_ai.main
#      или Debug → «palatium-ai: default (env/.env)»
#   7) Проверки: GET /health · GET /metrics · UI /ui (dev-token только при
#      ENVIRONMENT=development)
#
# ЛЕГЕНДА В КОММЕНТАРИЯХ
#   [MUST-SET]  — без этого приложение не поднимется / не будет полезным
#   [SECRET]    — только из Vault/CI/process env в staging/prod; никогда в git
#   [DEV]       — только development (HS256, dev-token, слабые бюджеты)
#   [STAGING]   — рекомендации для staging
#   [PROD]      — обязательные prod-ожидания (Zero Trust)
#   [OPTIONAL]  — можно оставить default
#
# ПРАВИЛА 2026
#   • В git только *.example. Реальные ключи — gitignore + Vault/CI.
#   • Не ставьте PyPI-пакет `jwt` — только Poetry-зависимость **PyJWT**.
#   • Prod: RS256+JWKS, HITL_SIGNING_SECRET, CORS allow-list, cost budgets >0,
#     LLM_FALLBACK_PROVIDERS ≥1 fallback, LangSmith с реальным ключом или OFF.
#   • Пустая строка "" ≠ отсутствие: для SecretStr часто «не задано» = пусто.
#   • Process env перекрывает файл (удобно для Vault inject).
#
# Полный ops-чеклист: docs/ops-readiness.md · секреты: docs/secrets.md
# =============================================================================


# =============================================================================
# 0) МИНИМУМ ДЛЯ ЛОКАЛЬНОГО СТАРТА (чеклист)
# =============================================================================
# [ ] POSTGRES_* + живой Postgres
# [ ] REDIS_* (HITL cards / daily cost; пустой пароль OK локально)
# [ ] JWT_SECRET ≥32 символов (HS256)  ИЛИ  JWKS_URL (RS256)
# [ ] LLM: ключ активного провайдера (OPENAI_ / ANTHROPIC_ / OLLAMA_ / QWEN_)
# [ ] EMBEDDING: ключ активного провайдера (если не ollama local)
# [ ] MCP_SERVERS или stubs через scripts/dev-up.ps1
# [ ] LANGCHAIN_TRACING_V2=false  ИЛИ  реальный LANGCHAIN_API_KEY
# [ ] (рекоменд.) LLM_FALLBACK_PROVIDERS + TURN_/DAILY_COST_BUDGET_USD >0


# =============================================================================
# 1) App
# =============================================================================
APP_NAME="palatium-ai"
APP_VERSION="0.1.0"

# [MUST-SET] development | staging | production
# Влияет на: uvicorn reload, POST /api/auth/dev-token (только development).
ENVIRONMENT="development"

# [DEV] 127.0.0.1 · [STAGING/PROD] 0.0.0.0 за reverse-proxy
APP_HOST="127.0.0.1"
APP_PORT=8000


# =============================================================================
# 2) Logging
# =============================================================================
# [DEV] DEBUG · [STAGING] INFO+JSON · [PROD] WARNING|INFO + JSON
LOG_LEVEL="INFO"
LOG_JSON=false
LOG_FILE=""
LOG_JSON_FILE=""
LOG_FILTER_MODULES=""
LOG_SUPPRESS_MODULES="urllib3,asyncio,httpx,httpcore,openai,LiteLLM,litellm"


# =============================================================================
# 3) Database (PostgreSQL) — [MUST-SET]
# =============================================================================
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME"                 # [SECRET][MUST-SET]
POSTGRES_DB="postgres"                        # не palatium_dev: схемы живут внутри этой БД
POSTGRES_SCHEMA="palatium_ai"
# [PROD] Prefer runtime role `palatium_app` (NOBYPASSRLS; alembic b3c4d5e6f7a8).
# Local docker may keep `postgres` for migrations + app; never grant BYPASSRLS to app.
DB_POOL_SIZE=10                               # [PROD] часто 20+
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true                         # отдаёт мёртвые соединения из пула
DB_POOL_TIMEOUT_SECONDS=30                    # ожидание свободного соединения из пула
DB_CONNECT_TIMEOUT_SECONDS=15                 # TCP-connect timeout asyncpg
DB_STARTUP_TIMEOUT_SECONDS=60                 # общий лимит инициализации БД при старте
DB_ECHO=false                                 # true только для SQL-debug
DB_RETRY_ATTEMPTS=4                           # попытки получить соединение (1 = без ретраев)
DB_RETRY_INITIAL_DELAY_SECONDS=0.25           # первая пауза backoff'а (jitter добавляет tenacity)
DB_RETRY_MAX_DELAY_SECONDS=2                  # верхняя граница паузы; она же Retry-After в 503


# =============================================================================
# 4) Cache (Redis) — HITL + daily cost budgets
# =============================================================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0                                    # [STAGING] лучше отдельный DB index
REDIS_PASSWORD=""                             # [SECRET][PROD] обязательно
REDIS_MAX_CONNECTIONS=20                      # размер пула соединений
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_SOCKET_KEEPALIVE=true


# =============================================================================
# 5) Security (Zero Trust) — [MUST-SET]
# =============================================================================
AUTH_ENABLED=true                             # [PROD] всегда true

# [DEV] HS256 + JWT_SECRET
# [STAGING/PROD] RS256 (или ES256) + JWKS_URL; JWT_SECRET оставьте пустым
JWT_ALGORITHM="HS256"
JWT_SECRET="change-me-dev-only-min-32-chars!!"  # [SECRET][DEV] ≥32 chars; rotate if leaked
HITL_SIGNING_SECRET=""                        # [SECRET] пусто → = JWT_SECRET (HS*);
                                              # [PROD][MUST-SET] при RS*/ES* — отдельный секрет
HITL_STEP_UP_METHOD="hmac_stub"               # local: hmac_stub; staging/prod: idp_acr|webauthn
HITL_STEP_UP_REQUIRED_ACR="urn:palatium:acr:step-up"
HITL_STEP_UP_REQUIRED_AMR=""                  # webauthn method defaults amr=webauthn when empty
HITL_STEP_UP_CARD_CLAIM="hitl_card_id"
HITL_STEP_UP_MAX_AGE_SECONDS="300"
HITL_STEP_UP_AUTHORIZE_URL="http://127.0.0.1:8000/api/auth/dev-hitl-step-up?card_id={card_id}&subject={subject}&challenge={challenge}&required_acr={required_acr}&card_claim={card_claim}&method={method}"
HITL_STEP_UP_REQUIRED=""                      # empty → staging/prod only; true for local IdP path tests
HITL_NOTIFY_WEBHOOK_URL=""                    # опционально: HTTPS webhook на HITL escalate
HITL_NOTIFY_WEBHOOK_TIMEOUT_SECONDS="5"
HITL_NOTIFY_EMAIL_TO=""                       # CSV recipients; empty = email channel off
HITL_NOTIFY_EMAIL_FROM=""
HITL_NOTIFY_SMTP_HOST=""
HITL_NOTIFY_SMTP_PORT="587"
HITL_NOTIFY_SMTP_USERNAME=""
HITL_NOTIFY_SMTP_PASSWORD=""
HITL_NOTIFY_SMTP_USE_TLS="true"
HITL_NOTIFY_SLACK_BOT_TOKEN=""                # xoxb-… ; empty = Slack channel off
HITL_NOTIFY_SLACK_CHANNEL=""

JWKS_URL=""                                   # [STAGING/PROD] https://idp/.../jwks.json
JWT_ISSUER=""                                 # [OPTIONAL] validate iss
JWT_AUDIENCE=""                               # [OPTIONAL] validate aud

# [DEV] TTL для POST /api/auth/dev-token (секунды). В staging/prod эндпоинт 404.
JWT_DEV_TOKEN_TTL_SECONDS=43200

# CSV origins UI. Wildcards (*) rejected at config load.
CORS_ORIGINS="http://127.0.0.1:8000,http://localhost:8000"

# When false, GET /metrics requires Bearer JWT (staging/prod force private scrape).
METRICS_PUBLIC=true

# Rate limit on expensive mutating / data APIs (CSV prefixes)
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_PATH_PREFIXES="/api/intents/,/api/hitl/,/api/documents/,/api/sessions/,/api/admin/,/api/agents/,/api/memory/"

# CSV JWT roles с доступом к /api/admin/kill-switch/*
ADMIN_ROLES="admin"
# Roles that receive HITL high-risk timeout escalations (GET /api/hitl/queue/escalated)
MANAGER_ROLES="manager,admin"


# =============================================================================
# 6) AI / LLM
# =============================================================================
# Активный провайдер: openai | anthropic | ollama | qwen | gateway
LLM_DEFAULT_PROVIDER="openai"                 # [MUST-SET]

# [PROD][рекоменд.] Ordered failover, CSV, ≥1 отличный от primary.
# Пример: "anthropic,ollama"
LLM_FALLBACK_PROVIDERS=""

# Per-tier override (AgentConfig.model_tier). Пустой provider → DEFAULT.
# Пустая model → default_model провайдера.
LLM_TIER_NANO_PROVIDER=""
LLM_TIER_NANO_MODEL=""
LLM_TIER_SMALL_PROVIDER=""
LLM_TIER_SMALL_MODEL=""
LLM_TIER_MID_PROVIDER=""
LLM_TIER_MID_MODEL=""
LLM_TIER_FRONTIER_PROVIDER=""
LLM_TIER_FRONTIER_MODEL=""
LLM_TIER_DEEP_REASONING_PROVIDER=""
LLM_TIER_DEEP_REASONING_MODEL=""

# --- OpenAI ---
OPENAI_API_KEY=""                             # [SECRET] sk-... если provider=openai
OPENAI_DEFAULT_MODEL="gpt-4o"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# --- Anthropic ---
ANTHROPIC_API_KEY=""                          # [SECRET] sk-ant-...
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-5"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=3

# --- Ollama (local или cloud) ---
# local:  BASE_URL=http://localhost:11434  API_KEY=""
# cloud:  BASE_URL=https://ollama.com/v1   API_KEY=<ключ>
OLLAMA_API_KEY=""                             # [SECRET]
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="llama3.2"
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.1

# --- Qwen / DashScope (или OpenAI-compatible gateway) ---
QWEN_API_KEY=""                               # [SECRET]
QWEN_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
QWEN_DEFAULT_MODEL="qwen-turbo"
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=3
QWEN_TEMPERATURE=0.1
QWEN_MAX_TOKENS=4096

# --- LiteLLM Gateway (provider="gateway") ---
# Единая точка входа: приложение ходит ТОЛЬКО в шлюз, реальные модели выбираются
# роутингом LiteLLM (LLM_TIER_*_MODEL = имена моделей шлюза, напр. tier-small).
# Это Settings-ключи (llm.gateway.*); docker-compose дополнительно интерполирует
# их в api.environment, поэтому держите их здесь — в §13 они не дублируются.
PALATIUM_GATEWAY_URL="http://litellm:4000"    # [MUST-SET] из хоста: http://127.0.0.1:4000
# Скоуп-ключ приложения. НЕ оставляйте плейсхолдер: LiteLLM не знает ключ, которого
# нет в LiteLLM_VerificationTokenTable → 401 (token_not_found_in_db).
# Сгенерировать: ./scripts/litellm-provision-key.ps1 (пишет реальный sk-...).
# Пусто → compose/dev-up подставят LITELLM_MASTER_KEY (не 401, но и не скоуп-ключ).
PALATIUM_GATEWAY_KEY=""                       # [SECRET] sk-...
GATEWAY_DEFAULT_MODEL="tier-small"            # модель по умолчанию, если tier не задан
GATEWAY_TIMEOUT=120                           # HTTP-таймаут запроса к шлюзу, сек


# =============================================================================
# 7) Embeddings
# =============================================================================
# openai | ollama | qwen | cohere
EMBEDDING_DEFAULT_PROVIDER="openai"           # [MUST-SET] fallback; schema overrides ниже
# memory.entries = 4096 native (qwen3-embedding-8b; gateway rejects MRL dimensions);
# knowledge = 1536 (text-embedding-3-small).
# Провайдер с другим dim к схеме не биндится — FTS / без векторов.
MEMORY_EMBEDDING_PROVIDER="qwen"              # [OPTIONAL] провайдер с dim=4096
KNOWLEDGE_EMBEDDING_PROVIDER=""               # [OPTIONAL] провайдер с dim=1536

# --- OpenAI ---
OPENAI_EMBEDDING_API_KEY=""                   # [SECRET] часто = OPENAI_API_KEY
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
OPENAI_EMBEDDING_TIMEOUT=60

# --- Ollama ---
OLLAMA_EMBEDDING_API_KEY=""                   # [OPTIONAL] cloud embeddings
OLLAMA_EMBEDDING_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_EMBEDDING_DIMENSION=768
OLLAMA_EMBEDDING_TIMEOUT=120

# --- Qwen / corporate OpenAI-compatible gateway (vLLM Qwen3-Embedding-8B) ---
QWEN_EMBEDDING_API_KEY=""                     # [SECRET]
QWEN_EMBEDDING_MODEL="embedding-model"        # id на gateway; root=Qwen/Qwen3-Embedding-8B
QWEN_EMBEDDING_DIMENSION=4096                 # native; do NOT send dimensions (no MRL)
QWEN_EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
QWEN_EMBEDDING_TIMEOUT=60

# --- Cohere ---
COHERE_EMBEDDING_API_KEY=""                   # [SECRET]
COHERE_EMBEDDING_MODEL="embed-multilingual-v3.0"
COHERE_EMBEDDING_DIMENSION=1024
COHERE_EMBEDDING_BASE_URL="https://api.cohere.com/v1"
COHERE_EMBEDDING_TIMEOUT=60


# =============================================================================
# 8) Memory spine
# =============================================================================
MEMORY_BACKEND=postgres                       # postgres | mem0 | graphiti
MEMORY_RECALL_MIN_CONFIDENCE=0.7
MEMORY_RECALL_MAX_ITEMS=8
MEMORY_RECALL_MAX_CHARS=800
CONTEXTUALIZER_DIALOG_MAX_CHARS=12000          # default MemoryConfig
WORKER_SUMMARY_MAX_CHARS=8000                 # default MemoryConfig
MCP_TOOL_OUTPUT_MAX_CHARS=3000

# [рекоменд. staging/prod] durable LangGraph checkpoints
LANGGRAPH_CHECKPOINT_POSTGRES=false
# [STAGING] hybrid FTS + embedding rerank (нужен embedding provider)
MEMORY_EMBEDDING_RERANK=false

# --- Promote: medium → long-term граф (060; отдельная ось от extract) ---
# Batch-сервис MemoryPromotionService, НЕ ad-hoc запись из агента.
# Ad-hoc MERGE в Neo4j мимо promote запрещён (060).
MEMORY_PROMOTE_ENABLED=true                   # выключает batch-promote целиком
MEMORY_PROMOTE_MIN_ACCESS_FREQUENCY=3         # сколько обращений к записи до promote
MEMORY_PROMOTE_MIN_IMPORTANCE=0.7             # порог importance (recency+relevance+access)
MEMORY_PROMOTE_BATCH_LIMIT=32                 # записей за один проход (1..128)

MEM0_API_KEY=""                               # [SECRET] если MEMORY_BACKEND=mem0
MEM0_HOST="https://api.mem0.ai"
MEM0_TIMEOUT_SECONDS=30

GRAPHITI_NEO4J_URI="bolt://localhost:7687"
GRAPHITI_NEO4J_USER="neo4j"
GRAPHITI_NEO4J_PASSWORD=""                    # [SECRET] = NEO4J_AUTH password в compose
GRAPH_QUERY_BACKEND="in_memory"               # in_memory | neo4j (requires neo4j driver + password)

WEB_FALLBACK_BACKEND="stub"                   # stub | http
WEB_FALLBACK_PROVIDER="ddg"                   # ddg (no key) | brave (requires API key)
WEB_FALLBACK_API_KEY=""                       # [SECRET] Brave Search token when provider=brave
WEB_FALLBACK_TIMEOUT_SECONDS=15
WEB_FALLBACK_RETRY_ATTEMPTS=3                 # tenacity retries on transient HTTP errors
WEB_FALLBACK_RETRY_DELAY_SECONDS=0.5
WEB_FALLBACK_CIRCUIT_FAILURES=3               # consecutive failures before open
WEB_FALLBACK_CIRCUIT_OPEN_SECONDS=30          # cooldown before half-open probe


# =============================================================================
# 9) MCP (Model Context Protocol)
# =============================================================================
MCP_ENABLED=true

# Shared opaque Bearer for local/legacy ([SECRET]; prefer MCP_JWT_SECRET)
MCP_AUTH_TOKEN="dev-mcp-local-token"          # [SECRET] MultiAuth fallback on stubs
MCP_JWT_SECRET="dev-mcp-jwt-secret-min-32-chars!!"  # [SECRET] HS256 aud=mcp:<server> (≥32)
MCP_JWT_ISSUER="palatium-mcp"
MCP_JWT_ALGORITHM="HS256"
MCP_JWT_TTL_SECONDS=300
MCP_AUTH_REQUIRED=false                       # [STAGING/PROD] true (JWT or static required)
MCP_SERVER_AUTH_TOKENS={}                     # optional JSON {"edms":"..."} ; empty = {}
MCP_ALLOW_HTTP_LOOPBACK=true                  # [STAGING/PROD] false
MCP_HTTP_ALLOWED_HOSTS="localhost,127.0.0.1,::1,mcp-edms,mcp-analytics"

# Способ 1 (remote stubs): scripts/dev-up.ps1 → 8080/8081
# Platform = Host-local (pins + PlatformToolHandler); never put platform in MCP_SERVERS.
# Compose api overrides MCP_SERVERS to Docker DNS (edms+analytics).
MCP_SERVERS='{"edms":"http://localhost:8080","analytics":"http://localhost:8081"}'

# Phase 6 optional gateway (ProxyProvider + pin allowlist). Stubs remain default.
# docker compose --profile mcp-gateway up → Host may point edms/analytics at 8090/8091.
# MCP_GATEWAY_SERVER="edms"                   # edms | analytics
# MCP_UPSTREAM_URL="http://mcp-edms:8080"     # stub/adapter the proxy forwards to
# MCP_UPSTREAM_BEARER=""                      # [SECRET] Bearer toward upstream stub/adapter
# SSRF gate (020): http:// upstream hosts must be allowlisted; https:// may use RFC1918.
# MCP_UPSTREAM_HTTP_ALLOWED_HOSTS="localhost,127.0.0.1,::1,edms,analytics,mcp-edms,mcp-analytics"
# Platform is NEVER proxied (Host PlatformToolHandler).

# Способ 2: файл JSON/YAML
MCP_SERVERS_FILE=""

# Способ 3: Consul (если URL задан — перекрывает статический JSON)
MCP_CONSUL_URL=""
MCP_CONSUL_PREFIX="mcp/"
MCP_CONSUL_TOKEN=""                           # [SECRET]
MCP_CONSUL_DATACENTER=""
MCP_CONSUL_WATCH_INTERVAL=60

MCP_TIMEOUT_SECONDS=30
# Per-tool overrides (JSON object): {"edms.search_documents":15,"analytics.get_sales_metrics":20}
# Key precedence: "server.tool" → "tool" → "default"; miss → MCP_TIMEOUT_SECONDS.
# Invariant: every value must be < the calling AgentConfig.timeout_seconds (070).
MCP_TOOL_TIMEOUT_SECONDS={}
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_DELAY=1.0


# =============================================================================
# 10) MCP Retention (offline scripts; dry-run by default)
# =============================================================================
# archive_mcp_tool_calls.py · purge_archived_mcp_tool_calls.py · retention_report
MCP_RETENTION_ARCHIVE_DAYS=90
MCP_RETENTION_PURGE_YEARS=3
MCP_RETENTION_BATCH_SIZE=500
MCP_RETENTION_EVENT=""
MCP_RETENTION_SERVER_NAME=""
MCP_RETENTION_IS_ERROR=""
MCP_RETENTION_EXECUTE="false"                 # true только осознанно (destructive)


# =============================================================================
# 10b) Global retention (CronJob / ``python -m palatium_ai.jobs.retention``)
# =============================================================================
# ADR 0002 + .cursor/plans/global-retention.md — dry-run by default.
RETENTION_SESSION_DAYS=30
RETENTION_MEMORY_MEDIUM_DAYS=30
RETENTION_MEMORY_EPISODE_DAYS=365
RETENTION_MEMORY_PII_DAYS=90
RETENTION_ATTACHMENT_PII_DAYS=90
RETENTION_KNOWLEDGE_ORPHAN_DAYS=7
RETENTION_GRAPH_PII_DAYS=90
RETENTION_AUDIT_HOT_DAYS=90
RETENTION_CHECKPOINT_DAYS=30
RETENTION_LANGFUSE_DAYS=30
RETENTION_MCP_ARCHIVE_DAYS=90
RETENTION_MCP_PURGE_YEARS=3
RETENTION_BATCH_SIZE=200
RETENTION_ANONYMIZE_GRACE_DAYS=7
RETENTION_EXECUTE=false                       # true только осознанно (destructive)


# =============================================================================
# 11) Observability / cost / audit
# =============================================================================
# LangSmith: без реального ключа держите tracing=false (иначе шум/ошибки SDK).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""                          # [SECRET] lsv2_... или выключите tracing
LANGCHAIN_PROJECT="palatium-ai-dev"

# Предупреждение + метрика, если суммарные hops turn > budget
TURN_HOP_BUDGET_MS=15000
MAX_QUALITY_REVISIONS=2                     # HITL quality revise budget (065)
CIRCUIT_FAILURES_TO_OPEN=3                  # node circuit breaker (020)
CIRCUIT_OPEN_SECONDS=30

# L1 exact-match response cache (P0.2): tenant-keyed SHA-256 in Redis
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600

# Hard USD caps (fail-closed → 402). 0 = выключено.
# [STAGING] начните с TURN=1.0 / DAILY=50 · [PROD] под ваш SLA
TURN_COST_BUDGET_USD=0
DAILY_COST_BUDGET_USD=0

# OTLP/HTTP (если коллектор есть); иначе оставить пустым.
# Порт 4318 (HTTP, путь /v1/traces): в коде HTTP-экспортёр. 4317 — gRPC → спам
# "Failed to export span batch". В Docker не используйте localhost — это сам контейнер.
OTEL_ENDPOINT=""

# Hash-chained audit log path (default внутри package data, если пусто)
AUDIT_LOG_FILE=""                             # пример: ./logs/audit-chain.log
AUDIT_HMAC_SECRET=""                          # optional HMAC over current_hash (tamper signal)


# =============================================================================
# 12) Agent evals (075) — nightly llm_judge only
# =============================================================================
# PR CI: scripts/run_agent_evals.py (cassette, no live LLM).
# Nightly: scripts/run_agent_evals_nightly.py · smoke: run_agent_evals_judge_smoke.py
# См. docs/agent-evals.md
# PALATIUM_EVAL_LIVE_JUDGE=0                   # 1 только для staging smoke / live nightly
# PALATIUM_EVAL_JUDGE_PROVIDER=anthropic       # MUST differ from generator provider (040)
# PALATIUM_EVAL_JUDGE_MODEL=                    # optional override
# PALATIUM_EVAL_AGENT_PROVIDER=openai          # generator provider for independence check
# PALATIUM_EVAL_LIVE_NIGHTLY=0                 # 1 = pytest full live nightly suite (expensive)


# =============================================================================
# 13) Docker Compose only (не Settings) — читает docker compose --env-file
# =============================================================================
POSTGRES_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6379
API_PUBLISH_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH="neo4j/palatium-neo4j"              # user/password; sync GRAPHITI_NEO4J_*
UVICORN_WORKERS=2
RUN_MIGRATIONS=1
WITH_GRAPHITI=0
# Build-arg образа api: 1 → poetry extras-группа `attachments` (minio, pypdf, python-docx).
# Без него minio-backend падает fail-closed на старте, а PDF/DOCX не парсятся (runbook §16.2).
WITH_ATTACHMENTS=0

# ---- LiteLLM Gateway ----
LITELLM_MASTER_KEY="sk-palatium-master"
LITELLM_DB_URL="postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/litellm"
# Отдельная БД gateway, НЕ POSTGRES_DB: на общей БД alembic-head LiteLLM и наш
# конфликтуют (`alembic upgrade head` падает на чужой ревизии). См. docs/runbook.md §6.
LITELLM_LOG="INFO"                            # INFO (default) | DEBUG; уровень процессов gateway
LITELLM_PUBLISH_PORT=4000                     # host-порт UI/API Gateway (loopback)
UI_USERNAME="admin"
UI_PASSWORD="changeme"

# ---- Ключ для приложения ----
# PALATIUM_GATEWAY_URL / PALATIUM_GATEWAY_KEY — это Settings-ключи (llm.gateway.*),
# поэтому объявлены один раз в §6 «LiteLLM Gateway». docker-compose дополнительно
# интерполирует их в api.environment, так что менять значения нужно там же (§6).

# ---- Langfuse (опционально) ----
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="http://langfuse:3000"
LANGFUSE_DB_URL="postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/langfuse"
LANGFUSE_PUBLISH_PORT=3000                    # host-порт UI Langfuse (loopback)
LANGFUSE_NEXTAUTH_SECRET=""                   # [SECRET][MUST-SET] >=32 символов, уникальный на стенд
LANGFUSE_SALT=""                              # [SECRET][MUST-SET] >=32 символов, уникальный на стенд
LANGFUSE_NEXTAUTH_URL="http://localhost:3000"  # внешний URL Langfuse (совпадает с publish-портом)

# ---- Langfuse v3 dependencies (profile: observability) ----
# v3 keeps traces in ClickHouse and queues ingestion through Valkey, so the profile
# needs credentials those containers cannot invent themselves. Everything *structural*
# (ClickHouse URL/user/db, S3 bucket, org/project labels) is a literal in
# docker-compose.yml on purpose: each extra ${VAR} would have to be declared in every
# profile template, and these values are not meant to vary per environment.
CLICKHOUSE_PASSWORD=""                          # [SECRET][MUST-SET] password for the ClickHouse user `langfuse`
LANGFUSE_ENCRYPTION_KEY=""                      # [SECRET][MUST-SET] exactly 64 hex chars; encrypts stored provider keys at rest
LANGFUSE_INIT_USER_PASSWORD=""                  # [SECRET][MUST-SET] UI admin password seeded on Langfuse's first boot


# =============================================================================
# 14) Observability stack overlay (deploy/observability) — Docker Compose only
# =============================================================================
# Opt-in overlay; never starts with the base stack:
#   docker compose --env-file env/.env \
#     -f docker-compose.yml -f deploy/observability/compose.observability.yml up -d
# SLO/SLI map + what is NOT monitored: deploy/observability/SLO.md
PROMETHEUS_PUBLISH_PORT=9090
PROMETHEUS_RETENTION="15d"                    # bounded on purpose; audit evidence lives in AUDIT_LOG_FILE
ALERTMANAGER_PUBLISH_PORT=9093
GRAFANA_PUBLISH_PORT=3000
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD=""                     # [SECRET][MUST-SET] no default password in git
GRAFANA_ROOT_URL="http://localhost:3000"
LOKI_PUBLISH_PORT=3100

# [STAGING/PROD] /metrics is forced private outside development (app.py), so the
# Prometheus scrape needs a valid JWT. development ignores this value.
PROMETHEUS_METRICS_TOKEN=""                   # [SECRET] Bearer for GET /metrics


# =============================================================================
# 15) Attachments (W2) - blob storage, AV scan, intake limits
# =============================================================================
# Off by default. Turning it on enables the upload/parse/scan pipeline, so it is
# refused outside local/test unless the storage and the scanner are configured:
#   * ATTACHMENTS_BLOB_BACKEND=memory|filesystem -> startup error in staging/production
#   * ATTACHMENTS_SCANNER_BACKEND=disabled -> startup error in staging/production
#   * ATTACHMENTS_MINIO_SECURE=false    -> startup error in staging/production
# The memory backend lives in one process: with UVICORN_WORKERS>1 the init and the
# complete call can land in different workers and the upload looks lost. Use
# filesystem for local dev, minio everywhere else.
# Minimal local setup to try attachments end-to-end (docs/runbook.md §16.4):
#   ATTACHMENTS_ENABLED="true"
#   ATTACHMENTS_BLOB_BACKEND="filesystem"
# Helpers: `make attach-up` (AV), `make attach-probe` (что именно лежит),
# `make attach-s3-up` (S3 с preflight образа, только если S3 действительно нужен).
ATTACHMENTS_ENABLED="false"
ATTACHMENTS_BLOB_BACKEND="memory"             # memory | filesystem (dev/test only) | minio
ATTACHMENTS_FILESYSTEM_ROOT=".local/attachments"  # filesystem backend root (gitignored)
# Compose-only overrides (the api container is read-only + on the compose network):
#   * root must live on a mounted volume, otherwise the store cannot write;
#   * clamd is addressed by service name, not by the host's localhost.
# Leave them unset for the Poetry host profile - the defaults above apply there.
# ATTACHMENTS_FILESYSTEM_ROOT_DOCKER="/app/var/attachments"
# ATTACHMENTS_CLAMAV_HOST_DOCKER="clamav"
ATTACHMENTS_MINIO_ENDPOINT="localhost:9000"
# Address the BROWSER uses for the presigned PUT (scheme decides http/https).
# Must be set whenever the store is reachable under a different name from inside
# the API process than from the browser; compose overrides the endpoint above to
# `minio:9000` while this stays `http://127.0.0.1:9000`. SigV4 signs the Host, so
# the URL cannot be rewritten after signing (see docs/runbook.md §16.4).
# Loopback literal, not `localhost`: the published port is bound to 127.0.0.1 only
# (020), while Windows resolves `localhost` to ::1 first and stalls ~2 s on every
# presigned PUT before falling back to IPv4.
ATTACHMENTS_MINIO_PUBLIC_ENDPOINT="http://127.0.0.1:9000"
# compose-only: how the api CONTAINER reaches the store. Defaults to the service name.
# For a store running on the host instead: "host.docker.internal:9000".
# ATTACHMENTS_MINIO_ENDPOINT_DOCKER="minio:9000"
# compose-only: S3 container image.
# The image is pinned by tag+digest inside docker-compose.yml (Silo, the maintained
# MinIO fork) rather than here. It used to be overridable through this key, but an
# env-supplied value silently beats the compose default — so the "pinned" image could
# be swapped by an env file without a code change (050). To bump the store, edit the
# tag *and* the digest together in docker-compose.yml.
# Published ports (loopback only). If you change API_PORT, update the public
# endpoint above to the same port — the two are not interpolated into each other.
ATTACHMENTS_MINIO_API_PORT=9000
ATTACHMENTS_MINIO_CONSOLE_PORT=9001
ATTACHMENTS_MINIO_ACCESS_KEY=""               # [SECRET][MUST-SET for minio] also MINIO_ROOT_USER
ATTACHMENTS_MINIO_SECRET_KEY=""               # [SECRET][MUST-SET for minio] also MINIO_ROOT_PASSWORD (>=8 chars)
ATTACHMENTS_MINIO_BUCKET="palatium-attachments"
ATTACHMENTS_MINIO_SECURE="false"              # must be true outside local/test (credentials on the wire)
ATTACHMENTS_MINIO_REGION="us-east-1"

ATTACHMENTS_SCANNER_BACKEND="disabled"        # disabled (dev/test only) | clamav
# clamav locally: docker compose --env-file env/.env --profile attachments up -d clamav
# (binds clamd to 127.0.0.1:${ATTACHMENTS_CLAMAV_PORT}; the API container overrides
#  ATTACHMENTS_CLAMAV_HOST=clamav, so this host value only applies to the host profile)
ATTACHMENTS_CLAMAV_HOST="localhost"
ATTACHMENTS_CLAMAV_PORT=3310
ATTACHMENTS_CLAMAV_TIMEOUT_SECONDS="30"

# Intake limits. The declared size is re-checked against the stored object, so a
# mismatching Content-Length is a rejection, not an accepted upload.
ATTACHMENTS_MAX_SIZE_BYTES=52428800           # 50 MiB
ATTACHMENTS_MAX_CHUNK_BYTES=8388608           # 8 MiB upload chunk / multipart piece
ATTACHMENTS_MAX_PER_TURN=5
ATTACHMENTS_MAX_FILENAME_CHARS=200
ATTACHMENTS_PRESIGNED_TTL_SECONDS=900         # how long the direct-upload URL stays valid
ATTACHMENTS_ATTACH_TTL_SECONDS=604800         # 7d; must outlive the thread, not the turn
ATTACHMENTS_INDEX_RETENTION_DAYS=365
ATTACHMENTS_MAX_PARSED_CHARS=2000000
ATTACHMENTS_MAX_PARSED_PAGES=500
# Expired rows reclaimed per retention pass (per owner; RLS forbids a global sweep).
ATTACHMENTS_SWEEP_BATCH_SIZE=200

# ---- Attachments: image OCR (progressive: Tesseract → Vision) ----
# ``auto`` (default): local Tesseract first, escalate to Vision on fail/low quality.
# ``disabled`` refuses image/* at intake. ``gateway`` always prefers Vision.
# ``tesseract`` is local-only. Vision escalate needs a gateway model alias.
ATTACHMENTS_IMAGE_OCR_BACKEND="auto"          # disabled | auto | gateway | tesseract
ATTACHMENTS_IMAGE_OCR_MODEL=""                # [MUST-SET for gateway] e.g. tier-vision; optional for auto
ATTACHMENTS_IMAGE_OCR_MAX_BYTES=8388608       # 8 MiB cap on the bytes sent to the model
ATTACHMENTS_IMAGE_OCR_TIMEOUT_SECONDS="30"
# Optional absolute path when tesseract is not on PATH (Windows portable, custom image).
ATTACHMENTS_TESSERACT_CMD=""
# Quality gate: escalate to Vision when OCR text is shorter / less printable than this.
ATTACHMENTS_OCR_MIN_CHARS=12
ATTACHMENTS_OCR_MIN_PRINTABLE_RATIO="0.55"
ATTACHMENTS_OCR_MIN_CONFIDENCE="55"           # escalate when Tesseract mean word conf is below this
# PDF text-layer density below this avg chars/page → OCR path (default 200).
ATTACHMENTS_PDF_MIN_AVG_CHARS_PER_PAGE=200
# PDF vision / figure enrichment (G14); Vision escalate when OCR insufficient + fitz.
ATTACHMENTS_PDF_VISION_MAX_PAGES=20
ATTACHMENTS_PDF_FIGURE_ENRICHMENT="true"
ATTACHMENTS_PDF_FIGURE_MAX_PAGES=8
# Local tabular ADA under HITL (G15). disabled | local
ATTACHMENTS_ANALYSIS_BACKEND="disabled"
# Extracted-text PII tiers (G06): tag | mask | reject
ATTACHMENTS_PII_POLICY="tag"

# Knowledge hybrid fusion: weighted (default) | rrf (Reciprocal Rank Fusion).
KNOWLEDGE_HYBRID_FUSION="weighted"
KNOWLEDGE_RRF_K=60
# Optional second-stage cosine rerank (needs knowledge embedding client).
KNOWLEDGE_EMBEDDING_RERANK="false"
KNOWLEDGE_EMBEDDING_RERANK_OVERFETCH=3
