{
  // Cursor Auto-Run — «не спрашивать каждый раз».
  // Схема: https://cursor.com/docs/reference/permissions
  // Документированные ключи: mcpAllowlist, terminalAllowlist, autoRun
  // (плюс //-комментарии). Неизвестные ключи Cursor игнорирует.
  //
  // Run Mode ЭТИМ ФАЙЛОМ НЕ ЗАДАЁТСЯ — он выбирается в UI:
  //   Settings → Agents → Approvals & Execution → Run Mode
  // Текущее значение: Run Everything (Always Run) —
  // подтверждено владельцем 2026-10-16, зафиксировано здесь (020).
  // permissions.json учитывается только когда Run Mode включён в UI.
  //
  // Ключ "approvalMode" удалён 2026-10-16: в публичной документации его нет
  // («Unknown keys are ignored»), а в UI он ломает выпадающий список Run Mode.
  //
  // ВАЖНО (020): жёсткие запреты живут НЕ здесь, а в .cursor/hooks.json и
  // остаются в силе при любом Run Mode:
  //   beforeShellExecution → deny-dangerous-shell.py — deny на rm -rf /, force-push, curl|bash;
  //   beforeMCPExecution   → mcp-rbac-guard.sh        — ask на мутации памяти/EDMS (HITL, 020/070).
  "terminalAllowlist": [
    "git status*",
    "git diff*",
    "git log*",
    "git show*",
    "git branch*",
    "git blame*",
    "git fetch*",
    "git rev-parse*",
    "git ls-files*",
    "git stash list*",
    "ruff *",
    "mypy *",
    "pytest*",
    "python -m pytest*",
    "python -m compileall*",
    "poetry run*",
    "poetry env*",
    "poetry show*",
    "poetry check*",
    "python -c*",
    "python -m*",
    "rg*",
    "grep*",
    "findstr*",
    "where.exe*",
    "Get-ChildItem*",
    "Get-Content*",
    "Select-String*",
    "Test-Path*",
    "docker compose ps*",
    "docker compose logs*",
    "docker ps*",
    "docker images*",
    "node *",
    "npm run*",
    "npm test*",
    "npx *",
    "pnpm *",
    "make *",
    "gum *"
  ],

  // Только read-инструменты из закрытого перечня 070.
  // Мутации памяти/EDMS (save_memory, forget_memory, extract_transcript_memories,
  // ingest_document) сюда НЕ добавлять — они обязаны проходить HITL (020)
  // через mcp-rbac-guard.sh.
  //
  // Действует в Run Mode = Allowlist; в Run Everything не консультируется.
  // NB: непустой allowlist делает UI-редактор allowlist read-only («Add to
  // allowlist» скрыт). Если выпадающий Run Mode начнёт капризничать —
  // первым делом временно убрать оба allowlist'а и перечитать файл.
  "mcpAllowlist": [
    "*:search_knowledge",
    "*:search_memory",
    "*:graph_query",
    "*:skill_reference",
    "*:web_fallback",
    "*:read_attachment"
  ],

  // Подсказки для Auto-review Auto-Run (docs-ключ "autoRun"; "autoReview" был
  // schema-алиасом). Консультируются ТОЛЬКО в Run Mode = Auto-review —
  // в Run Everything не используются, оставлены как профиль на случай возврата.
  "autoRun": {
    "allow_instructions": [
      "Read-only git-команды (status/diff/log/show/branch/blame) безопасны — запускать без вопроса.",
      "Локальные quality gates: ruff, mypy, pytest, compileall, poetry run — безопасны.",
      "Чтение и поиск по репозиторию (rg, grep, cat, Get-Content, Select-String, Test-Path) — безопасны.",
      "Просмотр состояния инфраструктуры (docker compose ps/logs, docker ps/images) — безопасен."
    ],
    "block_instructions": [
      "git push, особенно --force, в main/master/prod — блокировать (020).",
      "rm -rf, DROP TABLE/DATABASE, TRUNCATE, alembic upgrade/downgrade на реальной БД — блокировать.",
      "curl|bash, wget|sh, установка пакетов из недоверенных источников — блокировать.",
      "Любые write-операции в EDMS — только через HITL-карточку (020, 070).",
      "Запись/удаление в Neo4j мимо MemoryPromotionService — блокировать (060)."
    ]
  }
}
