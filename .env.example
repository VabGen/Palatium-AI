# .env.example

# --- Обязательные настройки приложения ---
APP_NAME="palatium-ai"
APP_VERSION="0.1.0"
ENVIRONMENT="development"          # development | staging | production

# --- Настройки логирования ---
LOG_LEVEL="INFO"                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                     # true/false – вывод в JSON
LOG_FILE=                          # путь к текстовому лог-файлу (опционально)
LOG_JSON_FILE=                     # путь к JSON-лог-файлу (опционально)
# Модули, для которых уровень ставится WARNING (через запятую)
LOG_SUPPRESS_MODULES="urllib3,asyncio,httpx"
# Модули, логи которых полностью игнорируются (через запятую)
LOG_FILTER_MODULES=""

# --- Базы данных и кэш ---
DATABASE_URL="postgresql://user:pass@localhost:5432/palatium"
REDIS_URL="redis://localhost:6379"

# --- Секреты ---
API_SECRET_KEY="your-secret-key-here"