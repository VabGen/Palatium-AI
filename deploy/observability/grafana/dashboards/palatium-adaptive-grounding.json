    {
      "id": 11,
      "type": "timeseries",
      "title": "1.1 Rollout decision split",
      "description": "At PCT=10 expect ~10%/90%. enabled=true=0 with PCT>0 \u2192 flag not on pods.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "palatium-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "palatium-prometheus"
          },
          "expr": "sum by (enabled) (rate(palatium_grounding_rollout_total[5m]))",
          "legendFormat": "{{enabled}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "1.2 Flag OFF ratio",
      "description": "Red near 1 at PCT=100 means config not propagated or shadow unexpectedly active.",
