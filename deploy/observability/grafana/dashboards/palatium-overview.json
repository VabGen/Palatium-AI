{
  "uid": "palatium-overview",
  "title": "Palatium AI — Overview",
  "description": "Agent SLO + safety controls. Metrics registry: rule 040. Provisioned from git; UI edits are disabled.",
  "tags": ["palatium", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Agent success ratio (5m)",
      "description": "SLI for the >95% SLO (docs/max-pro-level-tz.md §15).",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "palatium:agent_success_ratio:5m",
          "legendFormat": "success ratio"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API scrape up",
      "gridPos": { "h": 6, "w": 3, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "up{job=\"palatium-api\"}",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HITL card replay rejected (10m)",
      "description": "Any non-zero value is a security signal (020: cards are single-use).",
      "gridPos": { "h": 6, "w": 3, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "increase(palatium_hitl_card_replay_rejected_total[10m])",
          "legendFormat": "replays"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Audit chain write failures (10m)",
      "description": "Compliance control (040). Must stay at zero.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "increase(palatium_audit_write_failures_total[10m])",
          "legendFormat": "write failures"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "LLM cost / hour",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "palatium:llm_cost_usd_per_hour:1h",
          "legendFormat": "USD/h"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Agent node p95 latency by agent",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(palatium_agent_request_duration_seconds_bucket[5m])) by (le, agent_type))",
          "legendFormat": "{{agent_type}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Agent errors by type",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "sum by (agent_type, error_type) (rate(palatium_agent_errors_total[5m]))",
          "legendFormat": "{{agent_type}} / {{error_type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory query p95",
      "description": "SLO: < 200 ms (§15).",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "palatium:memory_query_p95_seconds:5m",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Circuit breaker state by target",
      "description": "0=closed, 1=half_open, 2=open (040).",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 2 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "palatium_circuit_breaker_state",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "RBAC denials by tool",
      "description": "Sustained denials = misconfigured allow-list or scope probing (020).",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "sum by (agent_type, tool_name) (rate(palatium_rbac_denied_total[5m]))",
          "legendFormat": "{{agent_type}} → {{tool_name}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Token usage by direction",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "sum by (direction) (rate(palatium_agent_token_usage_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Context tokens delivered by agent",
      "description": "Runaway growth means a JIT/compact regression (065).",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "sum by (agent_type) (rate(palatium_context_tokens_used[5m]))",
          "legendFormat": "{{agent_type}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Human escalations by reason",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "palatium-prometheus" },
          "expr": "sum by (reason) (rate(palatium_agent_human_escalation_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Platform logs (structlog JSON)",
      "description": "Filter by trace_id to follow one request across agents (040).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "loki", "uid": "palatium-loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "palatium-loki" },
          "expr": "{service=\"palatium-ai\"} | json",
          "legendFormat": ""
        }
      ]
    }
  ]
}
