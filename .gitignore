# .gitignore

# Python
__pycache__/
*.py[cod]
*.so
.Python
# env/
# ENV/
env.bak/
venv.bak/

# Poetry
# poetry.lock

# Виртуальное окружение
venv/
.venv/

# Secrets — never commit real env files (templates *.example stay tracked)
# These were commented out, which silently un-ignored live credential files and let
# env/.env (OLLAMA_API_KEY, PALATIUM_GATEWAY_KEY) reach the git history. Keep enabled.
env/.env
env/.env.dev
env/.env.staging
env/.env.prod
env/.env.local
env/.env.*.local
!env/.env.example
!env/.env.*.example

# Same class of bug, one level down: a copied legacy tree under mcp_servers/ brings its own
# .env, and its inner .gitignore has `.env` commented out — so the file is untracked *and*
# un-ignored, and a plain `git add .` would stage live credentials. Root-level patterns
# instead of editing the vendored .gitignore (017: exclude the path in our config, do not
# edit someone else's file). `*.example` templates stay tracked.
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
!**/.env.*.example

# Local dev process logs / PID state from scripts/dev-up.ps1
scripts/.dev/

# Логи
logs/
*.log
.cursor/logs/

# Coverage / caches
.coverage
htmlcov/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/

# Диагностический отчёт (scripts/diag-report.ps1) — env-зависимый вывод логов
diag-report.txt

# Редакторы
# .vscode/
.idea/
*.swp
*.swo

# Системные файлы
.DS_Store
Thumbs.db

# Сборка и дистрибутивы
build/
dist/
*.egg-info/
*.egg

# Chat UI (Vite)
web/node_modules/
web/dist/
web/dist-widget/

# Playwright (E2E виджета): отчёты и трейсы — артефакты прогона, не исходники
web/playwright-report/
web/test-results/
web/.playwright/
# Кадры визуальной сверки тем (`npm run test:shots`) — материал для глаз, не артефакт релиза
web/.shots/

# Local JavaEdms checkout (read-only reference; do not commit)
JavaEdms/
mcp_servers/edms/JavaEdms/

# CI eval reports (generated by scripts/run_agent_evals.py)
artifacts/
# Dev-only attachments blob store (ATTACHMENTS_BLOB_BACKEND=filesystem).
.local/