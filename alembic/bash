#!/bin/bash
# =============================================================================
# Alembic Cheatsheet & Workflow Guide
# =============================================================================
# Этот файл содержит основные команды для управления миграциями БД.
# =============================================================================

# -----------------------------------------------------------------------------
# ОСНОВНОЙ РАБОЧИЙ ПРОЦЕСС (Daily Workflow)
# -----------------------------------------------------------------------------

# Шаг 1: Изменить модели SQLAlchemy в коде
# Шаг 2: Создать автоматическую миграцию на основе изменений
uv run alembic revision --autogenerate -m "описание изменений"

# Шаг 3: ОБЯЗАТЕЛЬНО проверить сгенерированный файл в alembic/versions/xxx.py
# Autogenerate не идеален: он может пропустить переименования таблиц/колонок
# или создать лишние операции. Всегда читай код перед применением!

# Шаг 4: Применить миграцию к базе данных
uv run alembic upgrade head

# Шаг 5: Проверить текущее состояние БД
uv run alembic current


# -----------------------------------------------------------------------------
# УПРАВЛЕНИЕ ВЕРСИЯМИ (Upgrade / Downgrade)
# -----------------------------------------------------------------------------

# Применить ВСЕ ожидающие миграции до последней
uv run alembic upgrade head

# Применить миграции ДО конкретной ревизии (включительно)
uv run alembic upgrade <revision_id>

# Применить ровно N миграций вперёд от текущей
uv run alembic upgrade +2

# Откатить ПОСЛЕДНЮЮ применённую миграцию
uv run alembic downgrade -1

# Откатить ВСЕ миграции (удалить все таблицы, созданные Alembic)
uv run alembic downgrade base

# Откатить ДО конкретной ревизии
uv run alembic downgrade <revision_id>

# Откатить ровно N миграций назад
uv run alembic downgrade -3


# -----------------------------------------------------------------------------
# ИНСПЕКЦИЯ И ОТЛАДКА (Inspect & Debug)
# -----------------------------------------------------------------------------

# Показать текущую версию схемы в БД
uv run alembic current

# Показать полную историю миграций
uv run alembic history

# Показать историю с подробностями (зависимости, пути к файлам)
uv run alembic history --verbose

# Показать только последние N миграций
uv run alembic history --limit 5

# Показать детали конкретной миграции
uv run alembic show <revision_id>

# Показать информацию о текущей ревизии в БД
uv run alembic show current

# Показать информацию о HEAD-ревизии (последней доступной)
uv run alembic show head

# Показать все "головные" ревизии (ветки без дочерних миграций)
# Если здесь больше одной записи — у тебя развилка (branching)!
uv run alembic heads

# Показать информацию о ветвлениях в истории
uv run alembic branches

# Сравнить модели с БД и сообщить о расхождениях (без создания файлов)
uv run alembic check


# -----------------------------------------------------------------------------
# АДМИНИСТРИРОВАНИЕ И СЛУЖЕБНЫЕ ОПЕРАЦИИ
# -----------------------------------------------------------------------------

# Пометить БД как имеющую конкретную ревизию БЕЗ выполнения SQL
# Полезно: если схема уже изменена вручную или при первом деплое
uv run alembic stamp <revision_id>
uv run alembic stamp head

# Объединить несколько веток миграций в одну новую
uv run alembic merge -m "merge heads" <head1> <head2>

# Открыть файл миграции в редакторе ($EDITOR)
uv run alembic edit <revision_id>

# Создать служебную таблицу alembic_version, если её нет
uv run alembic ensure_version


# -----------------------------------------------------------------------------
# СОЗДАНИЕ МИГРАЦИЙ (Revision)
# -----------------------------------------------------------------------------

# Автоматически определить изменения моделей и создать миграцию
uv run alembic revision --autogenerate -m "описание"

# Создать ПУСТУЮ миграцию для ручного написания SQL/Python логики
uv run alembic revision -m "описание ручной миграции"


# -----------------------------------------------------------------------------
# ПОЛЕЗНЫЕ ФЛАГИ
# -----------------------------------------------------------------------------

# --sql          : Показать SQL-код операции БЕЗ выполнения (dry-run / отладка)
#                  Пример: uv run alembic upgrade head --sql

# --tag <tag>    : Добавить текстовый тег к операции (доступен в env.py)
#                  Пример: uv run alembic upgrade head --tag "deploy-v2"

# -x key=value   : Передать произвольные параметры в контекст миграции
#                  Доступны в env.py через context.config.get_x_argument()
#                  Пример: uv run alembic upgrade head -x tenant_id=123

# -d <directory> : Указать альтернативную директорию с конфигурацией Alembic
#                  Пример: uv run alembic -d alembic_staging upgrade head