{
  "name": "palatium-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:standalone": "vite --config vite.config.wc.ts",
    "build": "tsc --noEmit && vite build",
    "build:widget": "vite build --config vite.config.wc.ts && node scripts/widget-release.mjs",
    "verify:widget": "node scripts/widget-release.mjs --verify",
    "cem": "cem analyze --config custom-elements-manifest.config.mjs",
    "cem:check": "npm run cem && git diff --exit-code -- custom-elements.json",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @palatium/contract",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y.spec.ts",
    "test:shots": "node scripts/shots.mjs",
    "test:e2e:report": "playwright show-report",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@palatium/contract": "*",
    "lottie-react": "^3.1.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint-react/eslint-plugin": "^5.23.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "msw": "^3.0.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.5",
    "vitest": "^5.0.3"
  },
  "customElements": "custom-elements.json"
}
